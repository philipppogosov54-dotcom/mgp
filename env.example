# ==================== ИИ-ассистент МГП ====================
# Переменные окружения для TimeWeb Cloud
# 
# Все эти переменные уже настроены в панели TimeWeb Cloud
# Файл для документации и локальной разработки
# ============================================================

# ==================== Приложение ====================
APP_NAME="MGP AI Assistant"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ==================== PostgreSQL ====================
# Формат: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://gen_user:password@host:5432/default_db

# ==================== Аналитика ====================
ENABLE_ANALYTICS=true
LOG_API_CALLS=true
SESSION_CLEANUP_HOURS=24

# ==================== CORS ====================
# JSON массив разрешённых origins
CORS_ORIGINS=["*"]

# ==================== Tourvisor API ====================
# Документация: https://tourvisor.ru/api/
TOURVISOR_AUTH_LOGIN=your_login
TOURVISOR_AUTH_PASS=your_password
TOURVISOR_BASE_URL=http://tourvisor.ru/xml
TOURVISOR_TIMEOUT=30
TOURVISOR_MOCK=false

# ==================== YandexGPT API ====================
# Документация: https://cloud.yandex.ru/docs/yandexgpt/
YANDEX_FOLDER_ID=your_folder_id
YANDEX_API_KEY=your_api_key
YANDEX_MODEL=yandexgpt-lite
YANDEX_GPT_ENABLED=true

# ==================== Настройки поиска ====================
DEFAULT_NIGHTS_MIN=7
DEFAULT_NIGHTS_MAX=14
MAX_TOUR_OFFERS=5

# ==================== Rate Limiting ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# ==================== Admin (опционально) ====================
# API ключ для доступа к /api/v1/admin/*
# Пустой = без авторизации
ADMIN_API_KEY=
