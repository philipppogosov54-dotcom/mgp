# ==================== ЭТАП 1: ГОРОДА ДВОЙНОГО НАЗНАЧЕНИЯ ====================
# Города, которые могут быть И вылетом, И направлением отдыха
DUAL_PURPOSE_CITIES = {
    "сочи", "анапа", "геленджик", "калининград", 
    "симферополь", "минеральные воды", "минводы"
