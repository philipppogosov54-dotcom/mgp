# ==================== GREETING CLEANER (Python Regex) ====================
# Удаляет приветствия, "мусорные" фразы, смайлики и дубликаты из ответа

def clean_response_text(text: str, is_first_message: bool = False) -> str:
    """
    Очистка ответа от приветствий, "мусорных" фраз, смайликов и дубликатов.
    
    R2 FIX: Удаление повторяющихся фраз
    R3 FIX: Удаление смайликов/эмодзи
    
    Args:
        text: Текст ответа
        is_first_message: True если это первое сообщение в сессии (приветствие разрешено)
    
    Returns:
        Очищенный текст
    """
    if not text:
        return text
    
    cleaned = text.strip()
    
    # ==================== R3 FIX: Удаление смайликов/эмодзи ====================
    # Убираем Unicode эмодзи (кроме служебных типа ★ для звёзд)
    emoji_pattern = re.compile(
        "["
        "\U0001F600-\U0001F64F"  # emoticons (😀-🙏)
        "\U0001F300-\U0001F5FF"  # symbols & pictographs
        "\U0001F680-\U0001F6FF"  # transport & map symbols
        "\U0001F1E0-\U0001F1FF"  # flags
        "\U00002702-\U000027B0"  # dingbats
        "\U000024C2-\U0001F251"  # enclosed characters
        "]+", 
        flags=re.UNICODE
    )
    cleaned = emoji_pattern.sub('', cleaned)
    
    # Также убираем текстовые смайлики :) ;) :D и т.д.
    cleaned = re.sub(r'[;:]\s*[)D(P]', '', cleaned)
    
    # ==================== R2 FIX: Удаление повторяющихся фраз ====================
    duplicate_patterns = [
        r'(ищем туры[^.!?]*[.!?])\s*\1',  # "ищем туры... ищем туры..."
        r'(поиск[^.!?]*начат[^.!?]*[.!?])\s*\1',  # "поиск начат... поиск начат..."
        r'(отлично[^.!?]*[.!?])\s*\1',  # "отлично! отлично!"
        r'(понял[^.!?]*[.!?])\s*\1',  # "понял! понял!"
    ]
    for pattern in duplicate_patterns:
        cleaned = re.sub(pattern, r'\1', cleaned, flags=re.IGNORECASE)
    
    # ==================== Приветствия (только если не первое сообщение) ====================
    if not is_first_message:
        # Паттерны для удаления (только в начале строки)
        garbage_patterns = [
            r'^(Здравствуйте|Привет|Добрый день|Добрый вечер|Доброе утро)[!,.\s]*',
            r'^(Hello|Hi|Hey)[!,.\s]*',
            r'^(Понял вас|Принято|Хорошо|Отлично|Отличный выбор|Хороший выбор)[!,.\s]*',
            r'^(Я помогу вам|Я подберу|Давайте подберём|Рад помочь)[^.!?]*[.!?]?\s*',
            r'^(Я ИИ-ассистент|Я ваш помощник|Я консультант)[^.!?]*[.!?]?\s*',
            r'^(Спасибо за обращение|Благодарю)[^.!?]*[.!?]?\s*',
        ]
        
        for pattern in garbage_patterns:
            cleaned = re.sub(pattern, '', cleaned, flags=re.IGNORECASE | re.MULTILINE)
    
    # Убираем лишние пробелы и переносы
    cleaned = re.sub(r'\s{2,}', ' ', cleaned)
    cleaned = re.sub(r'\n{3,}', '\n\n', cleaned)
    cleaned = cleaned.strip()
    
    # P6 FIX: Capitalize первую букву
    if cleaned and len(cleaned) > 0 and cleaned[0].islower():
        cleaned = cleaned[0].upper() + cleaned[1:]
    
    # Если после очистки пусто — вернём оригинал
    if not cleaned:
        return text.strip()
    
    return cleaned


