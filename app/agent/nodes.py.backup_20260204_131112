            # Это защита от потери информации о детях при следующих проходах
            elif key == "children_mentioned":
                # Если уже было True, а новое значение False (неявное) — сохраняем True
                if old_value is True and value is False:
                    logger.info(f"   🛡️ Защита children_mentioned: сохраняем True")
                    continue  # Не затираем
            
            merged_params[key] = value
    
    # ==================== FIX: ИЗВЛЕЧЕНИЕ ФИЛЬТРОВ УСЛУГ И ТИПОВ ОТЕЛЕЙ ====================
    # Используем функции из tourvisor_constants для получения реальных API ID
    service_ids = get_service_ids(user_text)
    if service_ids:
        merged_params["services"] = service_ids
        logger.info(f"   🏨 FILTERS: services={service_ids}")
    
    hotel_types_list = get_hotel_types(user_text)
    if hotel_types_list:
        merged_params["hotel_types"] = hotel_types_list
        logger.info(f"   🏨 FILTERS: hotel_types={hotel_types_list}")
    
    # ==================== СБРОС ФЛАГОВ ПРИ КРИТИЧЕСКИХ ИЗМЕНЕНИЯХ ====================
    # При смене страны или даты — сбрасываем clarification_asked для нового поиска
    if critical_params_changed:
        state["awaiting_agreement"] = False
        state["pending_action"] = None
        state["error"] = None
        state["flex_search"] = False
        state["flex_days"] = 2  # Базовый диапазон ±2 дня
        state["search_attempts"] = 0
        state["offered_alt_departure"] = False
        
        # КРИТИЧНО: Сбрасываем ВСЕ флаги качества для нового запроса
        if country_changed:
            state["clarification_asked"] = False
            state["quality_check_asked"] = False
            state["skip_quality_check"] = False  # RESET FLAGS: для новой страны заново спросим про звёзды
            merged_params["skip_quality_check"] = False  # Также в параметрах
            logger.info(f"   🔄 Смена страны: {merged_params.get('destination_country')} → сброс ВСЕХ флагов качества")
    
    # ==================== ЭТАП 1: ОБРАБОТКА НЕЯСНОГО ГОРОДА (ambiguous_city) ====================
    # Если город двойного назначения (Сочи/Анапа) упомянут без контекста — уточняем
    ambiguous_city = entities.get("ambiguous_city")
    if ambiguous_city:
        state["search_params"] = merged_params
        state["intent"] = "clarify_city"
        state["ambiguous_city"] = ambiguous_city
        logger.info(f"   ❓ Требуется уточнение города: '{ambiguous_city}' — вылет или направление?")
        return state
    
    # ==================== КРИТИЧЕСКАЯ ПРОВЕРКА: ДЕТИ БЕЗ ВОЗРАСТА ====================
    # Если упомянуты дети, но возраст НЕ указан — БЛОКИРУЕМ поиск и спрашиваем
    children_mentioned = entities.get("children_mentioned") or merged_params.get("children_mentioned")
    children_count_mentioned = entities.get("children_count_mentioned") or merged_params.get("children_count_mentioned", 0)
    children_explicit_from_text = entities.get("children_explicit_from_text") or merged_params.get("children_explicit_from_text", False)
    existing_children_ages = merged_params.get("children", [])
    
    # ==================== P3 FIX v2: ПРОВЕРКА ГРУППЫ С ЗАЩИТОЙ ОТ ГАЛЛЮЦИНАЦИЙ ====================
    # ВАЖНО: Детей учитываем для total_people ТОЛЬКО если они явно упомянуты пользователем!
    # Если LLM галлюцинировал children — не считаем их для P3 эскалации.
    children_is_explicit = children_explicit_from_text or children_mentioned or children_count_mentioned > 0
    
    # Количество детей для расчёта total_people
    if children_is_explicit:
        # Дети явно упомянуты — учитываем их
        actual_children_count = len(existing_children_ages)
        if not actual_children_count and children_count_mentioned:
            actual_children_count = children_count_mentioned
    else:
        # Дети НЕ явные (возможно галлюцинация LLM) — не учитываем для P3
        actual_children_count = 0
        if existing_children_ages:
            logger.info(f"   🚫 P3: Игнорируем children={existing_children_ages} для расчёта total_people (не явные)")
    
    total_people = merged_params.get("adults", 0) + actual_children_count
    
    if total_people >= 10:
        # P3 FIX: 10+ человек — эскалация на менеджера (API не возвращает туры)
        state["search_params"] = merged_params
        state["intent"] = "group_booking"
        state["is_group_request"] = True
        state["group_size"] = total_people
        state["is_first_message"] = len(state["messages"]) <= 1 and not state.get("greeted", False)
        logger.info(f"   👥 P3: Группа {total_people} чел. (дети: {actual_children_count}, explicit={children_is_explicit}) → эскалация на менеджера")
        return state
    
    # Теперь проверяем — если дети упомянуты, но возраст не указан И это НЕ большая группа
    # — спрашиваем возраст
    if children_mentioned and not existing_children_ages:
        state["search_params"] = merged_params
        state["intent"] = "ask_child_ages"
        state["missing_child_ages"] = children_count_mentioned or 1
        # Не продолжаем — нужен возраст детей
        return state
    
    # Если новые возрасты извлечены — сбрасываем флаг
    if entities.get("children") and len(entities["children"]) > 0:
        merged_params["children_mentioned"] = False
        merged_params["children_count_mentioned"] = 0
    
    # ==================== P3 FIX: ГРУППЫ 7-9 ЧЕЛОВЕК ====================
    if total_people >= 7:
        # P3 FIX: 7-9 человек — продолжаем поиск, но с предупреждением
        state["is_group_request"] = True
        state["group_size"] = total_people
        state["group_warning"] = True  # Флаг для показа предупреждения
        logger.info(f"   👥 P3: Группа {total_people} чел. → поиск с предупреждением")
    
    # ==================== ВАЛИДАЦИЯ СТРАНЫ (Anti-Hallucination) ====================
    # Проверяем только если пользователь явно указал страну, которой нет в справочнике
    country = merged_params.get("destination_country")
    if country:
        # Проверяем, есть ли страна в валидном списке
        if country not in VALID_COUNTRIES:
            # Страна не в нашем справочнике — не ищем
            state["search_params"] = merged_params
            state["intent"] = "invalid_country"
            state["invalid_country"] = country
            state["is_first_message"] = len(state["messages"]) <= 1 and not state.get("greeted", False)
            return state
    
    # ==================== SOCHI-TO-SOCHI DETECTION ====================
    # P0 STABILIZATION: ОТКЛЮЧЕНО в MVP!
    # Авто-переключение в hotel_only режим деактивировано.
    # Если пользователь хочет "только отель", он должен написать это явно.
    # 
    # departure_city = merged_params.get("departure_city", "").lower().strip() if merged_params.get("departure_city") else ""
    # dest_region = merged_params.get("destination_region", "").lower().strip() if merged_params.get("destination_region") else ""
    # ... (логика закомментирована)
    #
    # TODO: Вернуть после стабилизации MVP с флагом ENABLE_AUTO_HOTEL_ONLY=true
    pass  # P0: hotel_only авто-детекция отключена
    
    # ==================== ЕСЛИ УКАЗАН ОТЕЛЬ — ПРОПУСКАЕМ ТОЛЬКО ЗВЁЗДНОСТЬ ====================
    # P1 FIX: Убрали skip_quality_check — теперь спрашиваем питание даже для конкретного отеля
    # if merged_params.get("hotel_name"):
    #     merged_params["skip_quality_check"] = True
    pass  # Питание будет спрошено в quality_check_handler
    
    # ==================== АНТИ-ЗАЦИКЛИВАНИЕ: Если stars/food_type обновлены — пропускаем ====================
    # P2 FIX: Пропускаем quality_check ТОЛЬКО если указано питание (не только звёзды!)
    stars_updated = entities.get("stars_updated", False)
    food_type_updated = entities.get("food_type_updated", False)
    
    # ШАГ 15 FIX: Пропускаем quality_check ТОЛЬКО если есть ОБА параметра (stars И food_type)
    # Если указано только питание — НЕ пропускаем, чтобы спросить звёзды
    # Если указаны только звёзды — НЕ пропускаем, чтобы спросить питание
    has_stars = merged_params.get("stars") is not None or merged_params.get("stars_explicit")
    has_food = merged_params.get("food_type") is not None or merged_params.get("food_type_explicit")
    has_both = has_stars and has_food
    
    if has_both:
        # Оба параметра указаны — пропускаем quality_check вопросы
        # HOTFIX: НЕ ставим skip_quality_check=True, т.к. это снимает фильтры в ШАГ14!
        # Вместо этого только пропускаем вопросы (quality_check_asked)
        state["quality_check_asked"] = True
        state["clarification_asked"] = True
        logger.info(f"   ⭐ ШАГ15: has_both=True → skip quality questions (stars={has_stars}, food={has_food})")
    else:
        logger.info(f"   ⭐ ШАГ15: quality_check needed (has_stars={has_stars}, has_food={has_food})")
    
    # Проверка "мне всё равно" / "рассмотрим варианты" — может быть в любом сообщении
    # HOTFIX: Используем ОТДЕЛЬНЫЙ флаг relax_filters_requested для снятия фильтров
    # skip_quality_check теперь только для пропуска вопросов, НЕ для модификации фильтров
    if check_skip_quality_phrase(user_text):
        merged_params["skip_quality_check"] = True
        merged_params["relax_filters_requested"] = True  # HOTFIX: отдельный флаг для снятия фильтров
        logger.info(f"   🔓 HOTFIX: relax_filters_requested=True (skip phrase detected)")
        state["clarification_asked"] = True  # Пользователь дал понять что ему всё равно
        # НЕ устанавливаем stars и food_type — пусть поиск вернёт все варианты
    
    # Автоматический расчёт ночей
    # P6: НЕ пересчитываем если это праздник/выходные — nights уже корректны
    # P1 FIX: НЕ пересчитываем если nights_explicit=True (пользователь указал явно)
    if "date_from" in merged_params and "date_to" in merged_params:
        d_from = merged_params["date_from"]
        d_to = merged_params["date_to"]
        if isinstance(d_from, date) and isinstance(d_to, date):
            # P6: Праздники и выходные уже имеют корректные nights
            # P1 FIX: Если nights указан явно — НЕ пересчитываем!
            nights_explicit = merged_params.get("nights_explicit", False)
            if merged_params.get("date_precision") not in ("holiday", "weekend") and not nights_explicit:
                nights = (d_to - d_from).days
                if nights > 0:
                    merged_params["nights"] = nights
                    logger.info(f"   📅 Авто-расчёт nights={nights} из дат (nights_explicit=False)")
            elif nights_explicit:
                logger.info(f"   🛡️ P1: nights={merged_params.get('nights')} защищён (nights_explicit=True)")
    
    if "date_from" in merged_params and "nights" in merged_params and "date_to" not in merged_params:
        d_from = merged_params["date_from"]
        if isinstance(d_from, date):
            merged_params["date_to"] = d_from + timedelta(days=merged_params["nights"])
    
    # Обновляем состояние
    # ШАГ 2 FIX: Передаём search_mode для hotel_only!
    missing = get_missing_required_params(merged_params, state.get("search_mode", "package"))
    cascade_stage = get_cascade_stage(merged_params, state.get("search_mode", "package"))
    
    # Определяем, первое ли это сообщение (для приветствия)
    is_first = len(state["messages"]) <= 1 and not state.get("greeted", False)
    
    # ==================== ВАЖНО: ЕСЛИ ВСЕ ПАРАМЕТРЫ СОБРАНЫ — ИЩЕМ ====================
    # Если cascade_stage == 6, значит все параметры собраны, принудительно переходим к поиску
    # Это гарантирует, что бот не будет "болтать" вместо поиска
    if cascade_stage == 6 and intent not in ("booking", "phone_provided", "group_booking", "invalid_country"):
        intent = "search_tour"
    
    state["search_params"] = merged_params
    state["missing_info"] = missing
    
    # FIX 2: Сохраняем hot_tours если был установлен ранее
    # Проблема: при ответе "москва" на горящие туры, intent менялся на search_tour/greeting
    previous_intent = state.get("intent")
    if previous_intent == "hot_tours" and intent in ("search_tour", "greeting", "general_chat"):
        logger.info(f"   🔥 FIX 2: Сохраняем intent=hot_tours (было {intent})")
        intent = "hot_tours"
    
    state["intent"] = intent
    state["cascade_stage"] = cascade_stage
    state["is_first_message"] = is_first
    
    return state


async def faq_handler(state: AgentState) -> AgentState:
    """Обработка FAQ."""
    intent = state.get("intent", "")
    
    # ==================== АНТИ-ПОВТОРНОЕ ПРИВЕТСТВИЕ ====================
    # Если это "greeting" intent в середине диалога — отвечаем кратко
    if intent == "greeting":
        messages_count = len(state.get("messages", []))
        already_greeted = state.get("greeted", False)
        
        if already_greeted or messages_count > 2:
            # Уже здоровались — отвечаем кратко
            state["response"] = "Чем могу помочь?"
        else:
            # Первое приветствие — только в первой сессии
            # НЕ используем "Здравствуйте" — бот должен сразу к делу
            state["response"] = "В какую страну планируете поездку?"
            state["greeted"] = True
        return state
    
    if intent in FAQ_RESPONSES:
        faq_answer = FAQ_RESPONSES[intent]
    else:
        faq_answer = "К сожалению, не нашёл ответ. Свяжитесь с менеджером."
    
    # ==================== PR5: FAQ-RETURN — "Продолжим подбор:" ====================
    # После FAQ ответа добавляем следующий каскадный вопрос (если cascade_stage < 6)
    params = state.get("search_params", {}) or {}
    search_mode = state.get("search_mode", "package")
    cascade_stage = get_cascade_stage(params, search_mode)
    
    continuation_question = None
    if cascade_stage < 6:
        # Определяем следующий вопрос по cascade_stage
        if cascade_stage == 1:
            continuation_question = "В какую страну планируете поездку?"
        elif cascade_stage == 2:
            continuation_question = "Из какого города вылет?"
        elif cascade_stage == 3:
            continuation_question = "Когда планируете вылет?"
        elif cascade_stage == 4:
            continuation_question = "Сколько человек поедет?"
        elif cascade_stage == 5:
            continuation_question = "Какой уровень отеля предпочитаете?"
        
        if continuation_question:
            state["response"] = f"{faq_answer}\n\nПродолжим подбор: {continuation_question}"
            state["last_question_type"] = ["destination", "departure_city", "dates", "adults", "stars"][cascade_stage - 1]
            logger.info(f"   📖 PR5 FAQ-RETURN: cascade_stage={cascade_stage}, added continuation question")
        else:
            state["response"] = faq_answer
    else:
        state["response"] = faq_answer
    
    return state


async def invalid_country_handler(state: AgentState) -> AgentState:
