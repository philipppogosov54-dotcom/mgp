def check_agreement_phrase(text: str) -> bool:
    """Проверяет, является ли текст фразой согласия."""
    text_lower = text.lower().strip()
    # Короткие ответы (1-3 слова) проверяем на согласие
    if len(text_lower.split()) <= 3:
        for phrase in AGREEMENT_PHRASES:
            if phrase in text_lower:
                return True
    return False


async def input_analyzer(state: AgentState) -> AgentState:
    """Анализ ввода пользователя."""
    if not state["messages"]:
        return state
    
    last_message = state["messages"][-1]
    if last_message["role"] != "user":
        return state
    
    user_text = last_message["content"]
    awaiting_phone = state.get("awaiting_phone", False)
    
    # P10 FIX: Логирование исходного текста для отладки
    # Показываем первые 100 символов для безопасности (без PII в логах)
    last_question = state.get("last_question_type")
    logger.info(f"   📝 USER INPUT: '{user_text[:100]}{'...' if len(user_text) > 100 else ''}' | context: {last_question}")
    
    # ==================== SEARCH MODE DETECTION ====================
    # Определяем режим поиска из текста пользователя
    detected_mode = detect_search_mode(user_text)
    current_mode = state.get("search_mode", "package")
    
    # ПРИНУДИТЕЛЬНО сохраняем режим поиска (даже если package)
    # hotel_only и burning режимы требуют особой обработки!
    if detected_mode != "package" or current_mode == "package":
        state["search_mode"] = detected_mode
    
    # Логируем ВСЕГДА
    logger.info(f"   🔍 SEARCH MODE: {state.get('search_mode', 'package')} (detected: {detected_mode})")
    
    # ==================== КОНТЕКСТНАЯ ОСВЕДОМЛЁННОСТЬ ====================
    # КРИТИЧНО: Если уже идёт сбор параметров (cascade_stage > 1) и ответ короткий,
    # это скорее всего ответ на предыдущий вопрос, а не новый intent!
    current_cascade_stage = state.get("cascade_stage", 1)
    current_params = state.get("search_params", {}) or {}
    
    # Логируем для отладки
    logger.info(f"   📊 Текущий cascade_stage: {current_cascade_stage}")
    logger.info(f"   📊 Текущие параметры: {current_params}")
    
    # ==================== PR3: MIXED-INITIATIVE EARLY EXTRACTION ====================
    # КРИТИЧНО: Извлекаем ВСЕ слоты из сообщения СРАЗУ, независимо от last_question_type.
    # Это гарантирует что "out-of-turn" данные (например "2 взрослых" когда спрашивали дату)
    # не будут потеряны.
    # 
    # АРХИТЕКТУРНАЯ ЗАМЕТКА: extract_entities_regex вызывается также в extract_entities_with_llm.
    # Это намеренное дублирование: early extraction позволяет обновить параметры ДО early returns
    # (например awaiting_agreement), а LLM extraction делает финальное извлечение с приоритизацией.
    # Кэширование между вызовами потребует рефакторинга, пока оставляем как есть.
    last_question = state.get("last_question_type")
    pr3_early_entities = extract_entities_regex(user_text, last_question_type=last_question)
    
    # PR3: Обновляем search_params с извлечёнными данными ПЕРЕД early returns
    if pr3_early_entities:
        pr3_merged = current_params.copy()
        pr3_slots_added = []
        
        for key, value in pr3_early_entities.items():
            if value is not None and value != "":
                # PR3: Не перезаписываем explicit слоты без подтверждения
                # Но ДОБАВЛЯЕМ новые слоты которых ещё нет
                old_value = pr3_merged.get(key)
                is_explicit_key = f"{key}_explicit"
                was_explicit = pr3_merged.get(is_explicit_key, False)
                
                # PR3: Skip metadata keys
                if key.endswith("_explicit") or key.endswith("_updated") or key in ("date_precision", "is_exact_date"):
                    pr3_merged[key] = value
                    continue
                
                # P11 FIX: Защита точных дат от перезаписи month-only
                # Аналогично P7 в merge entities, но для PR3 Early Extraction
                if key in ("date_from", "date_to"):
                    current_dates_confirmed = pr3_merged.get("dates_confirmed", False)
                    new_date_precision = pr3_early_entities.get("date_precision")
                    current_precision = pr3_merged.get("date_precision")
                    
                    if current_dates_confirmed and current_precision == "exact" and new_date_precision == "month":
                        logger.info(f"   🛡️ P11: PR3 защита даты — precision=exact, dates_confirmed=True → НЕ перезаписываем {key} month-only")
                        continue
                
                # PR3: Добавляем новый слот или обновляем не-explicit
                if old_value is None or not was_explicit:
                    pr3_merged[key] = value
                    if key in ("adults", "nights", "stars", "food_type", "date_from", "departure_city"):
                        pr3_slots_added.append(f"{key}={value}")
                elif old_value != value and was_explicit:
                    # PR3: Конфликт — старое explicit значение отличается от нового
                    # Пока просто логируем, не перезаписываем
                    logger.info(f"   ⚠️ PR3: Конфликт слота '{key}': old={old_value} (explicit), new={value}")
        
        if pr3_slots_added:
            logger.info(f"   🔄 PR3: Early extraction добавил слоты: {', '.join(pr3_slots_added)}")
            state["search_params"] = pr3_merged
            current_params = pr3_merged  # Обновляем для последующих проверок
            
            # PR3 CONSERVATIVE: НЕ пересчитываем cascade_stage здесь!
            # Cascade logic остаётся в конце input_analyzer как раньше.
            # Мы только добавляем слоты которые будут учтены при финальном расчёте.
    
    # ==================== PR3: ANTI-LOOP DETECTION ====================
    # Отслеживаем повторения последнего вопроса
    question_repeat_count = state.get("question_repeat_count", 0)
    last_asked_question = state.get("last_asked_question_type")
    
    if last_question and last_asked_question == last_question:
        question_repeat_count += 1
        state["question_repeat_count"] = question_repeat_count
        logger.info(f"   🔁 PR3: Вопрос '{last_question}' повторяется {question_repeat_count} раз")
    else:
        state["question_repeat_count"] = 0
        question_repeat_count = 0
    
    # ==================== FIX: MONTH-ONLY DATE COMPLETION ====================
    # Критический фикс: когда бот спросил "Какого числа {месяц}?", 
    # пользователь отвечает числом — нужно объединить с сохранённым месяцем,
    # а НЕ отправлять в LLM (которая может интерпретировать "1" как "1 марта")
    
    def parse_russian_day_number(text: str) -> Optional[int]:
        """Парсит число дня из текста (цифры или словами)."""
        text_lower = text.lower().strip()
        
        # 1. Сначала пробуем цифры (1-31)
        digit_match = re.search(r'\b([1-9]|[12]\d|3[01])\b', text_lower)
        if digit_match:
            return int(digit_match.group(1))
        
        # 2. Словесные числа (родительный падеж)
        word_to_num = {
            # 1-10
            "первого": 1, "первое": 1, "первый": 1,
            "второго": 2, "второе": 2, "второй": 2,
            "третьего": 3, "третье": 3, "третий": 3,
            "четвёртого": 4, "четвертого": 4, "четвёртое": 4, "четвертое": 4,
            "пятого": 5, "пятое": 5,
            "шестого": 6, "шестое": 6,
            "седьмого": 7, "седьмое": 7,
            "восьмого": 8, "восьмое": 8,
            "девятого": 9, "девятое": 9,
            "десятого": 10, "десятое": 10,
            # 11-19
            "одиннадцатого": 11, "одинадцатого": 11,
            "двенадцатого": 12,
            "тринадцатого": 13,
            "четырнадцатого": 14,
            "пятнадцатого": 15,
            "шестнадцатого": 16,
            "семнадцатого": 17,
            "восемнадцатого": 18,
            "девятнадцатого": 19,
            # 20, 30
            "двадцатого": 20, "двадцатое": 20,
            "тридцатого": 30, "тридцатое": 30,
            "тридцать первого": 31,
        }
        
        # Проверяем составные числа (21-29, 31)
        compound_patterns = [
            (r"двадцать\s*перв", 21),
            (r"двадцать\s*втор", 22),
            (r"двадцать\s*треть", 23),
            (r"двадцать\s*четв[её]рт", 24),
            (r"двадцать\s*пят", 25),
            (r"двадцать\s*шест", 26),
            (r"двадцать\s*седьм", 27),
            (r"двадцать\s*восьм", 28),
            (r"двадцать\s*девят", 29),
            (r"тридцать\s*перв", 31),
        ]
        
        for pattern, num in compound_patterns:
            if re.search(pattern, text_lower):
                return num
        
        # Проверяем простые слова
        for word, num in word_to_num.items():
            if word in text_lower:
                return num
        
        return None
    
    last_question_type = state.get("last_question_type")
    if (last_question_type == "dates" and 
        current_params.get("date_precision") == "month" and 
        not current_params.get("dates_confirmed") and
        current_params.get("detected_month")):
        
        # Пробуем извлечь число дня из ответа пользователя (цифры или словами)
        day = parse_russian_day_number(user_text)
        if day:
            month = current_params["detected_month"]
            existing_date = current_params.get("date_from")
            year = existing_date.year if existing_date else date.today().year
            
            # Если месяц в прошлом — берём следующий год
            if month < date.today().month or (month == date.today().month and day < date.today().day):
                year += 1
            
            try:
                new_date = date(year, month, day)
                current_params["date_from"] = new_date
                current_params["dates_confirmed"] = True
                current_params["is_exact_date"] = True
                current_params["date_precision"] = "exact"
                
                # Рассчитываем date_to если есть nights
                nights = current_params.get("nights", 7)
                current_params["date_to"] = new_date + timedelta(days=nights)
                
                state["search_params"] = current_params
                state["last_question_type"] = None  # Сбрасываем
                
                month_names = {
                    1: "января", 2: "февраля", 3: "марта", 4: "апреля",
                    5: "мая", 6: "июня", 7: "июля", 8: "августа",
                    9: "сентября", 10: "октября", 11: "ноября", 12: "декабря"
                }
                logger.info(f"   📅 MONTH-ONLY FIX: {day} {month_names.get(month)} → {new_date}")
                
                # Устанавливаем intent для маршрутизации к поиску
                state["intent"] = "search_tour"
                state["cascade_stage"] = 6  # Все параметры собраны — готовы к поиску
                
                # КРИТИЧНО: Возвращаемся, чтобы LLM не перезаписал дату!
                return state
                
            except ValueError as e:
                logger.warning(f"   ⚠️ MONTH-ONLY FIX: Невалидная дата {day}.{month} — {e}")
                # Продолжаем обычную логику
    
    # ==================== P5 FIX + FIX 5.2: ОБРАБОТКА alt_food ОТДЕЛЬНО ====================
    # Эта проверка должна быть ДО check_agreement_phrase, потому что
    # "другой отель" / "другие даты" — НЕ фразы согласия!
    # FIX 5.2: Обрабатываем оба варианта: alt_food_hotel и alt_food_country
    pending_action = state.get("pending_action")
    if pending_action in ("alt_food_hotel", "alt_food_country") and state.get("awaiting_agreement"):
        text_lower = user_text.lower().strip()
        current_params = state["search_params"].copy() if state["search_params"] else {}
        
        # Варианты "другой отель"
        other_hotel_phrases = ["другой отель", "другую гостиницу", "другой вариант", "подбери другой", "подберите другой"]
        # Варианты "другие даты"
        other_dates_phrases = ["другие даты", "другую дату", "изменить дату", "изменить даты", "сменить даты", "другое время"]
        # Варианты согласия
        agree_phrases = ["да", "покажи", "покажите", "хочу", "давай", "ок", "окей", "конечно", "согласен", "согласна"]
        
        if any(phrase in text_lower for phrase in other_hotel_phrases):
            # ==================== FIX 5.2: СОХРАНЕНИЕ ЗВЁЗД ПРИ "ДРУГОЙ ОТЕЛЬ" ====================
            # Сбрасываем hotel_name, но СОХРАНЯЕМ stars и food_type!
            preserved_stars = current_params.get("stars")
            preserved_food = current_params.get("food_type")
            
            current_params["hotel_name"] = None
            current_params["hotel_name_explicit"] = False
            # FIX 5.2: Явно сохраняем звёзды (они могли быть от исходного отеля)
            if preserved_stars:
                current_params["stars"] = preserved_stars
                current_params["stars_explicit"] = True  # Сохраняем как явный параметр
            
            state["search_params"] = current_params
            state["awaiting_agreement"] = False
            state["pending_action"] = None
            state["alt_food_checked"] = False
            
            # FIX 5.2: Формируем ответ с указанием сохранённых критериев
