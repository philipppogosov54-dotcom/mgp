# ==================== SEARCH MODES (Strict Slot Filling) ====================

# PR1: Travel context words for "горит" validation
TRAVEL_CONTEXT_WORDS = [
    "тур", "отдых", "отпуск", "вылет", "перелёт", "перелет", "море", "пляж",
    "турци", "египет", "оаэ", "эмират", "таиланд", "кипр", "греци", "мальдив",
    "сочи", "анапа", "крым", "геленджик", "отель", "hotel", "путёвк", "путевк",
    "поехать", "слетать", "лететь", "билет на самолёт", "билет на самолет"
]

def detect_search_mode(text: str) -> str:
    """
    Определяет режим поиска из текста пользователя.
    
    Режимы:
    - "hotel_only" — только отель (НЕ требует departure_city)
    - "burning" — горящие туры (гибкие даты)
    - "package" — пакетный тур (требует departure_city)
    
    PR1 CHANGES:
    - Added hotel_only triggers: "без авиа", "сам доберусь", "на машине", etc.
    - Added travel-context check for "горит" to avoid false positives
    - NO auto hotel_only for RU resorts without explicit trigger
    """
    text_lower = text.lower()
    
    # P0 STABILIZATION: hotel_only режим — ТОЛЬКО по явному запросу!
    # PR1: Расширенный список явных триггеров
    hotel_only_triggers = [
        # Базовые (P0)
        "без перелет", "без перелёт", 
        "только отель", "только проживание",
        "наземное обслуживание", "наземка",
        # PR1: Новые триггеры
        "без авиа",  # "без авиабилетов", "без авиа"
        "без билет",  # "без билетов" (в контексте авиа, не концерт)
        "без самолет", "без самолёт",
        "сам добер", "сами добер",  # "сам доберусь", "сами доберёмся"
        "доберусь сам", "доберёмся сами",
        "на машине", "едем на машине", "поедем на машине",
        "на поезде", "едем поездом", "поездом",
        "на своём транспорте", "на своем транспорте",
        "проживание без перелет", "проживание без перелёт",
        # Английские варианты
        "ground service", "hotel only",
    ]
    
    for trigger in hotel_only_triggers:
        if trigger in text_lower:
            # PR1: Anti-false-positive для "без билетов"
            # Исключаем нерелевантные контексты
            if "без билет" in trigger:
                false_positive_contexts = ["концерт", "театр", "кино", "матч", "футбол", "хоккей"]
                if any(ctx in text_lower for ctx in false_positive_contexts):
                    logger.info(f"🔍 SKIP hotel_only trigger '{trigger}' — non-travel context")
                    continue
            logger.info(f"🔍 DETECTED SEARCH MODE: hotel_only (trigger: '{trigger}')")
            return "hotel_only"
    
    # Режим "горящие туры"
    # PR1: Для "горит" требуем travel-context чтобы избежать false positives
    burning_triggers_strict = [
        "горящ",  # "горящий тур", "горящие"
        "ближайший вылет", "на ближайшие",
        "последняя минута", "last minute",
        "дешёвый тур", "дешевый тур"
    ]
    
    burning_triggers_context_required = [
        "горит",  # "горит отпуск", "что горит" — требует контекст
        "срочно",  # "срочно нужен тур" — требует контекст
        "горячий"  # "горячий тур" vs "горячий кофе"
    ]
    
    # Strict triggers — срабатывают без проверки контекста
    for trigger in burning_triggers_strict:
        if trigger in text_lower:
            logger.info(f"🔍 DETECTED SEARCH MODE: burning (trigger: '{trigger}')")
            return "burning"
    
    # Context-required triggers — требуют travel-context
    for trigger in burning_triggers_context_required:
        if trigger in text_lower:
            # Проверяем наличие travel-context
            has_travel_context = any(ctx in text_lower for ctx in TRAVEL_CONTEXT_WORDS)
            if has_travel_context:
                logger.info(f"🔍 DETECTED SEARCH MODE: burning (trigger: '{trigger}' + travel context)")
                return "burning"
            else:
                logger.info(f"🔍 SKIP burning trigger '{trigger}' — no travel context")
    
    # По умолчанию — пакетный тур
    # PR1: RU resorts (Сочи, Анапа, Крым) остаются в package mode без явного hotel_only триггера
