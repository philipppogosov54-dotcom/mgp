    invalid_country_name = state.get("invalid_country", "это направление")
    
    alternatives = ", ".join(POPULAR_ALTERNATIVES)
    
    state["response"] = (
        f"К сожалению, мы пока не продаём туры {to_country(invalid_country_name)}.\n\n"
