    return state


async def child_ages_handler(state: AgentState) -> AgentState:
    """
    Обработчик для запроса возраста детей.
    
    КРИТИЧНО по ТЗ: Если пользователь упомянул детей, но не указал возраст,
    мы ОБЯЗАНЫ спросить — возраст влияет на цену тура!
    """
    params = state.get("search_params", {})
    children_count = state.get("missing_child_ages", 1)
    
    # Формируем контекст для пользователя
    context_parts = []
    if params.get("destination_country"):
        context_parts.append(params["destination_country"])
    if params.get("departure_city"):
        context_parts.append(f"из {params['departure_city']}")
    if params.get("adults"):
        context_parts.append(f"{params['adults']} взр")
    
    context = ", ".join(context_parts) if context_parts else "ваш запрос"
    
    # Формируем вопрос
    if children_count == 1:
        question = "Укажите, пожалуйста, возраст ребёнка (это важно для расчёта цены)."
    else:
        question = f"Укажите, пожалуйста, возраст всех {children_count} детей (это важно для расчёта цены)."
    
    # БЕЗ "Принято:" — сразу вопрос
    state["response"] = question
    state["last_question_type"] = "children_ages"
    
    return state


async def general_chat_handler(state: AgentState) -> AgentState:
    """Обработка общих вопросов."""
    if not state["messages"]:
        return state
    
    user_message = state["messages"][-1]["content"]
    params = state.get("search_params", {})
    
    if settings.YANDEX_GPT_ENABLED:
        from app.agent.llm import llm_client
        
        try:
            response = await llm_client.generate_conversational_response(
                user_message=user_message,
                search_params=params,
                conversation_history=state["messages"]
            )
            if response:
                # P6 FIX: Capitalize первую букву ответа
                if response and len(response) > 0 and response[0].islower():
                    response = response[0].upper() + response[1:]
                state["response"] = response
                return state
        except Exception as e:
            print(f"General chat LLM error: {e}")
    
    fallback_response = generate_fallback_response(user_message, params)
    # P6 FIX: Capitalize первую букву ответа
    if fallback_response and len(fallback_response) > 0 and fallback_response[0].islower():
        fallback_response = fallback_response[0].upper() + fallback_response[1:]
    state["response"] = fallback_response
    return state


def generate_fallback_response(user_message: str, params: dict) -> str:
    """Генерирует ответ без LLM."""
    text_lower = user_message.lower()
    
    country = None
    for key in DESTINATIONS_KNOWLEDGE.keys():
        if key in text_lower:
            country = key
            break
    
    if any(word in text_lower for word in ["погода", "температур", "климат"]):
        if country and country in DESTINATIONS_KNOWLEDGE:
            info = DESTINATIONS_KNOWLEDGE[country]
            return f"В {country.title()} сезон: {info.get('сезон', 'уточняйте')}. Планируете поездку туда?"
        return "Погода зависит от страны. Турция — май-октябрь, Египет — круглый год, ОАЭ — октябрь-апрель. Куда присматриваетесь?"
    
    if any(word in text_lower for word in ["отель для дет", "с детьми", "семейн"]):
        return "Для семей с детьми рекомендую Турцию — Белек, Сиде. Короткий перелёт, всё включено, аквапарки. Рассматриваете это направление?"
    
    if any(word in text_lower for word in ["лучше", "или", "выбрать"]):
        return "Турция — короткий перелёт, всё включено. Египет — круглый год, дешевле. ОАЭ — роскошь, зимой. Что для Вас важнее?"
    
    return "С удовольствием помогу. В какую страну планируете поездку?"


async def quality_check_handler(state: AgentState) -> AgentState:
    """Вопрос о качестве (звёзды/питание)."""
    params = state.get("search_params", {})
    
    # P1 FIX: Если отель известен — спрашиваем ТОЛЬКО про питание (не про звёзды)
    if params.get("hotel_name"):
        # Проверяем, указано ли уже питание
        if not params.get("food_type") and not params.get("food_type_explicit"):
            hotel_name = params.get("hotel_name")
            state["response"] = (
                f"Отель {hotel_name} — отличный выбор! "
                f"Какой тип питания предпочитаете: всё включено, полупансион или завтраки?"
            )
            state["last_question_type"] = "food_type"
            state["quality_check_asked"] = True
            return state
        # Питание уже известно — на поиск
        state["cascade_stage"] = 6
        return state
    
    # P2 FIX: Если звёзды уже указаны — спрашиваем только питание
    if params.get("stars") and params.get("stars_explicit"):
        if not params.get("food_type") and not params.get("food_type_explicit"):
            stars = params.get("stars")
            state["response"] = (
                f"Отлично, {stars} звёзд! "
                f"Какой тип питания предпочитаете: всё включено, полупансион или завтраки?"
            )
            state["last_question_type"] = "food_type"
            state["quality_check_asked"] = True
            return state
        # Питание тоже известно — на поиск
        state["cascade_stage"] = 6
        return state
    
    # ШАГ 15 FIX: Если питание уже указано — спрашиваем только звёзды
    if params.get("food_type") and params.get("food_type_explicit"):
        if not params.get("stars") and not params.get("stars_explicit"):
            food_type = params.get("food_type")
            food_name = {
                "AI": "всё включено",
                "UAI": "ультра всё включено", 
                "FB": "полный пансион",
                "HB": "полупансион",
                "BB": "завтраки",
                "RO": "без питания"
            }.get(str(food_type), str(food_type))
            
            state["response"] = (
                f"Отлично, питание {food_name}! "
                f"Какой уровень отеля предпочитаете: 3, 4 или 5 звёзд?"
            )
            state["last_question_type"] = "stars"
            state["quality_check_asked"] = True
            logger.info(f"   ⭐ ШАГ15: food_only ({food_type}) → asking stars")
            return state
        # Звёзды тоже известны — на поиск
        state["cascade_stage"] = 6
        return state
    
    # Обычный вопрос про звёзды + питание
    state["response"] = "Какой уровень отеля — 5 звёзд всё включено или рассмотрим варианты?"
    state["quality_check_asked"] = True
    state["last_question_type"] = "stars"
    
    return state


async def tour_searcher(state: AgentState) -> AgentState:
    """Поиск туров."""
    params = state["search_params"]
    
    # ==================== P1: ГОРЯЩИЕ ТУРЫ ЧЕРЕЗ hottours.php ====================
    # Для горящих туров используем ДРУГОЙ API endpoint — без обязательных дат/ночей!
    intent = state.get("intent")
    is_hot_param = params.get("is_hot_tour", False)
    is_hot_tours = intent == "hot_tours" or is_hot_param
    
    logger.info(f"   🔍 tour_searcher: intent={intent}, is_hot_param={is_hot_param}, is_hot_tours={is_hot_tours}")
    
    if is_hot_tours:
        logger.info("🔥 P1: Горящие туры — используем hottours.php")
        
        try:
            # Загружаем справочники
            await tourvisor_service.load_countries()
            await tourvisor_service.load_departures()
            
            # Город вылета — если не указан, используем Москву (разумный дефолт для горящих)
            departure_city = params.get("departure_city", "Москва")
            departure_id = tourvisor_service.get_departure_id(departure_city) or 1
            
            # Страна — опциональна для горящих туров
            country = params.get("destination_country")
            country_id = None
            if country:
                country_id = tourvisor_service.get_country_id(country)
            
            logger.info(f"   🔥 Горящие: departure={departure_city}(id={departure_id}), country={country}(id={country_id})")
            
            # Вызов hottours.php
            # P4 FIX: Увеличиваем лимит для POST-фильтрации
            tours = await tourvisor_service.get_hot_tours(
                departure_id=departure_id,
                country_id=country_id,
                limit=50,  # P4: увеличиваем для POST-фильтрации
                departure_city=departure_city
            )
            
            # ==================== P4 FIX: POST-ФИЛЬТРАЦИЯ ГОРЯЩИХ ТУРОВ ====================
            # API hottours.php не поддерживает фильтры adults/stars/food_type
            # Фильтруем результаты на стороне клиента
            original_count = len(tours) if tours else 0
            
            if tours:
                filtered_tours = []
                filter_stars = params.get("stars") if params.get("stars_explicit") else None
                filter_food = params.get("food_type") if params.get("food_type_explicit") else None
                filter_country = params.get("destination_country")  # FIX 1.1/1.3: Фильтр по стране
                
                logger.info(f"   🔥 P4: POST-фильтрация горящих туров: country={filter_country}, stars={filter_stars}, food={filter_food}")
                
                for tour in tours:
                    # tour - это TourOffer объект с атрибутами hotel_stars, food_type, country
                    
                    # ==================== FIX 1.1/1.3: ФИЛЬТР ПО СТРАНЕ ====================
                    # API hottours.php возвращает туры из ВСЕХ стран, даже если country_id указан
                    # Фильтруем на стороне клиента
                    if filter_country:
                        tour_country = getattr(tour, "country", "")
                        # Сравниваем нечувствительно к регистру
                        if tour_country.lower() != filter_country.lower():
                            continue
                    
                    # Фильтр по звёздам (если указаны)
                    if filter_stars:
                        tour_stars = getattr(tour, "hotel_stars", 0)
                        if tour_stars != filter_stars:
                            continue
                    
                    # Фильтр по питанию (если указано)
                    if filter_food:
                        tour_food = getattr(tour, "food_type", None)
                        if tour_food:
                            # tour_food - это FoodType enum, сравниваем .value
                            if hasattr(tour_food, "value"):
                                if tour_food.value != filter_food:
                                    continue
                            elif str(tour_food).upper() != filter_food.upper():
                                continue
                    
                    filtered_tours.append(tour)
                
                logger.info(f"   🔥 P4: Отфильтровано: {original_count} → {len(filtered_tours)} туров")
                tours = filtered_tours[:5]  # Отдаём максимум 5
            
            state["tour_offers"] = tours
            state["api_call_made"] = True
            
            if not tours:
                if original_count > 0:
                    # Были туры, но отфильтрованы
                    state["response"] = (
                        f"Горящих туров с вашими критериями не найдено "
                        f"(было {original_count} предложений, но не подошли по фильтрам).\n\n"
                        "Хотите посмотреть горящие туры без фильтров или обычные туры?"
                    )
                else:
                    # Нет горящих вообще
                    state["response"] = (
                    "Сейчас нет горящих туров по вашим параметрам. "
                    "Популярные направления: Турция, Египет, ОАЭ. "
                    "Хотите посмотреть обычные туры в эти страны?"
                )
            
            return state
            
        except Exception as e:
            logger.error(f"❌ Ошибка поиска горящих туров: {e}")
            state["error"] = str(e)
            state["tour_offers"] = []
            return state
    
    # ==================== STRICT QUALIFICATION GUARDRAILS ====================
    # КРИТИЧНО: НЕ ЗАПУСКАЕМ ПОИСК без обязательных параметров!
    # Для обычного поиска — СТРОГАЯ проверка
    
    # 1. Город вылета — ОБЯЗАТЕЛЬНО (кроме режима hotel_only!)
    search_mode = state.get("search_mode", "package")
    logger.info(f"🏨 DEBUG tour_searcher: search_mode={search_mode}, departure_city={params.get('departure_city')}")
    # Блокируем, только если это НЕ hotel_only и города нет
    if search_mode != "hotel_only" and not params.get("departure_city"):
        state["missing_info"] = ["departure_city"]
        return state
    
    # 2. Дата вылета — ОБЯЗАТЕЛЬНО
    if not params.get("date_from"):
        state["missing_info"] = ["date_from"]
        return state
    
    # 3. Состав (adults) — ОБЯЗАТЕЛЬНО и ЯВНО указан!
    # КРИТИЧНО: НЕ подставляем adults=1 молча! Агент ОБЯЗАН спросить!
    adults_explicit = params.get("adults_explicit", False)
    adults = params.get("adults")
    
    if not adults or not adults_explicit:
        # Агент ОБЯЗАН спросить: "Сколько человек полетит?"
        state["missing_info"] = ["adults"]
        state["intent"] = "ask_pax"  # Специальный intent для уточнения состава
        return state
    
    # 4. Длительность (nights) — ОБЯЗАТЕЛЬНО!
    if not params.get("nights"):
        state["missing_info"] = ["nights"]
        return state
        
        # 5. Страна назначения — ОБЯЗАТЕЛЬНО
        if not params.get("destination_country"):
            state["missing_info"] = ["destination_country"]
            return state
    
    if state["missing_info"]:
        return state
    
    try:
        
        destination = Destination(
            country=params.get("destination_country"),
            region=params.get("destination_region"),
            resort=params.get("destination_resort"),
            city=params.get("destination_city")
        )
        
        original_date_from = params.get("date_from")
        nights = params.get("nights", 7)
        
        # ==================== УМНЫЙ ДИАПАЗОН ДАТ ====================
        # КРИТИЧНО: Если указана ТОЧНАЯ дата — используем узкое окно!
        # Точная дата: "15 февраля" → ±0-1 день
        # Размытая дата: "в середине февраля" → ±2 дня
        # После согласия пользователя: ±5 дней
        
        is_exact_date = params.get("is_exact_date", False)
        
        if state.get("flex_search"):
            # Пользователь согласился расширить поиск
            flex_days = 5
        elif is_exact_date:
            # STRICT DATE SEARCH: Если дата ТОЧНАЯ — ищем СТРОГО в этот день!
            # Пользователь сказал "15 февраля" → ищем только 15 февраля
            flex_days = 0
            logger.info(f"   📅 STRICT DATE: точная дата {original_date_from.strftime('%d.%m')}, flex_days=0")
        else:
            # Размытая дата ("в феврале", "на следующей неделе") — стандартное окно
            flex_days = state.get("flex_days", 2)
        
        # ==================== КРИТИЧНО: РАЗДЕЛЕНИЕ ДАТ И НОЧЕЙ ====================
        # datefrom/dateto в Tourvisor API — это диапазон дат ВЫЛЕТА
        # nightsfrom/nightsto — это количество ночей (передаётся отдельно!)
        # 
        # БЫЛО (ОШИБКА): date_to = original_date_from + flex_days + nights
        # Это приводило к тому, что при flex_days=5 и nights=5 → date_to на 10 дней вперёд
        # И SearchRequest вычислял nights = 15 вместо 5!
        #
        # ПРАВИЛЬНО: расширяем только диапазон дат вылета, ночи передаём отдельно
        date_from = original_date_from - timedelta(days=flex_days)
        date_to = original_date_from + timedelta(days=flex_days)  # БЕЗ nights!
        
        # Сохраняем оригинальную дату для сообщения
        state["original_date_from"] = original_date_from
        
        # Логируем для отладки
        logger.info(f"   📅 Диапазон дат: {date_from} - {date_to}, ночей: {nights}")
        
        # КРИТИЧНО: adults уже проверен выше — дефолт НЕ используем!
        # ==================== ГОРОД ВЫЛЕТА: HOTEL_ONLY НЕ ТРЕБУЕТ ====================
        departure_city = params.get("departure_city")
        search_mode = state.get("search_mode", "package")
        
        # Для hotel_only режима город вылета НЕ требуется!
        if search_mode == "hotel_only":
            departure_city = None  # Будет departure=0 в API
            logger.info("   🏨 Режим HOTEL_ONLY: город вылета не требуется")
        elif not departure_city:
            # Для обычных туров город обязателен
            logger.error("❌ КРИТИЧЕСКАЯ ОШИБКА: departure_city не указан!")
            state["missing_info"] = ["departure_city"]
            return state
        else:
            logger.info(f"   ✈️ Город вылета: {departure_city}")
        
        # === P1: ЗАПРЕТ НЕЯВНЫХ ФИЛЬТРОВ ===
        # Добавляем stars/food_type/hotel_name ТОЛЬКО если явно указаны!
        
        # === ШАГ 14: FILTER RELAXATION POLICY ===
        # HOTFIX: Используем relax_filters_requested (НЕ skip_quality_check!)
        # relax_filters_requested ставится ТОЛЬКО при явной skip-фразе ("рассмотрим варианты", "любые")
        # skip_quality_check теперь только для пропуска вопросов, НЕ для модификации фильтров
        # → hotel_name_explicit НИКОГДА не трогаем
        relax_filters = params.get("relax_filters_requested", False)
        
        if relax_filters:
            # Пользователь явно сказал "рассмотрим варианты" — снимаем фильтры для поиска
            stars_for_search = None
            food_type_for_search = None
            logger.info(f"   🔓 ШАГ14: relax_filters_requested=True → stars=None, food=None (filters relaxed)")
        else:
            # Используем explicit фильтры как есть
            stars_for_search = params.get("stars") if params.get("stars_explicit") else None
            food_type_for_search = params.get("food_type") if params.get("food_type_explicit") else None
        
        # hotel_name НИКОГДА не ослабляем
        hotel_name_for_search = params.get("hotel_name") if params.get("hotel_name_explicit") else None
        
        logger.info(f"   🔧 P1 Explicit filters: stars={stars_for_search} (explicit={params.get('stars_explicit')}, relax={relax_filters}), "
                   f"food={food_type_for_search} (explicit={params.get('food_type_explicit')}, relax={relax_filters}), "
                   f"hotel={hotel_name_for_search} (explicit={params.get('hotel_name_explicit')})")
        
        # HOTFIX v2: Дети передаются в API ТОЛЬКО если явно упомянуты пользователем
        # Проблема: LLM галлюцинирует children=[2] когда дети НЕ упомянуты
        # Решение v2: используем children_explicit_from_text (regex-детекция из текста)
        children_for_search = []
        children_mentioned = params.get("children_mentioned", False)
        children_count_mentioned = params.get("children_count_mentioned", 0)
        children_explicit_from_text = params.get("children_explicit_from_text", False)
        raw_children = params.get("children", [])
        
        # Дети передаются ТОЛЬКО если:
        # 1) children_explicit_from_text=True (regex нашёл возраст или детские слова)
        # 2) children_mentioned=True (паттерн "2+1", "с ребёнком", etc)
        # 3) children_count_mentioned > 0 (явно упомянуто количество детей)
        # Если LLM галлюцинировал children=[2] без явного упоминания — игнорируем!
        children_is_explicit = children_explicit_from_text or children_mentioned or children_count_mentioned > 0
        
        if raw_children and children_is_explicit:
            children_for_search = raw_children
            logger.info(f"   👶 HOTFIX v2: children={children_for_search} ACCEPTED (explicit={children_explicit_from_text}, mentioned={children_mentioned}, count={children_count_mentioned})")
        elif raw_children:
            # Есть children, но нет явного упоминания — LLM галлюцинация, игнорируем
            logger.info(f"   🚫 HOTFIX v2: Игнорируем children={raw_children} (explicit={children_explicit_from_text}, mentioned={children_mentioned}, count={children_count_mentioned}) — LLM галлюцинация")
        
        search_request = SearchRequest(
            adults=params.get("adults"),  # Без дефолта! Проверено выше.
            children=children_for_search,  # HOTFIX: только если явно упомянуты!
            destination=destination,
            hotel_name=hotel_name_for_search,  # P1: только если explicit!
            stars=stars_for_search,  # P1: только если explicit!
            date_from=date_from,
            date_to=date_to,
            nights=nights,  # КРИТИЧНО: передаём явно, не вычисляем из дат!
            food_type=food_type_for_search,  # P1: только если explicit!
            departure_city=departure_city,  # СТРОГО без дефолта!
            search_mode=search_mode,  # P7: передаём режим для hotel_only
            # === НОВЫЕ ПАРАМЕТРЫ (GAP Analysis) ===
            services=params.get("services"),  # ID услуг отелей
            hotel_types=params.get("hotel_types"),  # Типы отелей (family, beach...)
            tour_type=params.get("tour_type"),  # Тип тура (1=пляжный, 2=горнолыжный...)
        )
        
        # Загружаем справочники если ещё не загружены
        await tourvisor_service.load_countries()
        await tourvisor_service.load_departures()
        
        # P1: hot_tours уже обработаны в начале функции, здесь только обычный поиск
        
        # ==================== СТРОГИЙ ПОИСК ПО ОТЕЛЮ ====================
        # Если hotel_name указан — ОБЯЗАТЕЛЬНО ищем через find_hotel_by_name
        hotel_name = params.get("hotel_name")
        hotel_ids = None
        is_strict = False
        
        # Сохраняем информацию о найденном отеле для Smart Alternatives
        found_hotel_info = None
        
        if hotel_name:
            # Ищем ID отеля в справочнике
            country_for_hotel = params.get("destination_country")
            hotels_found = await tourvisor_service.find_hotel_by_name(
                query=hotel_name,
                country=country_for_hotel
            )
            
            if hotels_found:
                # P6 FIX: Увеличен лимит с 3 до 15 отелей для лучшего покрытия сетей/брендов
                hotel_ids = [h.hotel_id for h in hotels_found[:15]]
                is_strict = True
                # Сохраняем инфо о первом отеле для Smart Alternatives
                found_hotel_info = hotels_found[0]
                state["found_hotel_name"] = found_hotel_info.name
                state["found_hotel_stars"] = found_hotel_info.stars
                # HotelInfo использует region_name, не region
                state["found_hotel_region"] = getattr(found_hotel_info, 'region_name', '') or getattr(found_hotel_info, 'resort_name', '')
            else:
                # ==================== FAIL-FAST: ОТЕЛЬ НЕ НАЙДЕН В СПРАВОЧНИКЕ ====================
                state["tour_offers"] = []
                state["hotel_not_found"] = True
                state["response"] = (
                    f"К сожалению, я не нашёл отель {hotel_name}.\n\n"
                    f"Уточните название или давайте посмотрим другие варианты {in_country(country_for_hotel)}."
                )
                return state
        
        # P1: Обычный асинхронный поиск через search.php
        result = await tourvisor_service.search_tours(
            search_request,
            is_strict_hotel_search=is_strict,
            hotel_ids=hotel_ids
        )
        
        # P1: Отмечаем что API вызван
        state["api_call_made"] = True
        
        # ==================== FIX: UNKNOWN COUNTRY FALLBACK ====================
        # Если страна не найдена в справочнике — красивый ответ с альтернативами
        if result.reason == "unknown_country":
            user_country = params.get("destination_country", "указанное направление")
            state["tour_offers"] = []
            state["unknown_country"] = True
            
            # Собираем альтернативы из COUNTRIES_MAP (популярные направления)
            popular_destinations = [
                "Турция", "Египет", "ОАЭ", "Таиланд", "Мальдивы",
                "Шри-Ланка", "Куба", "Доминикана", "Вьетнам", "Индонезия"
            ]
            # Фильтруем только те, что есть в нашем справочнике
            available = [d for d in popular_destinations if d.lower() in [k.lower() for k in COUNTRIES_MAP.values()]][:8]
            alternatives_text = ", ".join(available[:6]) if available else "Турцию, Египет, ОАЭ, Таиланд, Мальдивы"
            
            state["response"] = (
                f"К сожалению, сейчас мы не предлагаем пакетные туры {to_country(user_country)}.\n\n"
                f"Популярные направления, которые могу предложить:\n"
                f"🌴 {alternatives_text}\n\n"
                f"Выберите направление из списка — и я продолжу подбор с вашими параметрами "
                f"(вылет, даты, состав туристов сохранены)."
            )
            state["awaiting_country_selection"] = True  # Не продолжать каскад
            logger.info(f"   🌍 FIX: Страна '{user_country}' недоступна → предложены альтернативы")
            return state
        
        # ==================== FIX: UNKNOWN DEPARTURE CITY FALLBACK ====================
        # Если город вылета не найден в справочнике — предложить альтернативы
        if result.reason == "unknown_departure":
            user_city = params.get("departure_city", "указанный город")
            state["tour_offers"] = []
            state["unknown_departure"] = True
            
            # Собираем альтернативы из реального справочника departures
            # Популярные города вылета (из tourvisor_constants.py DEPARTURES)
            try:
                from app.core.tourvisor_constants import DEPARTURES
                # Берём все уникальные города с заглавной буквы
                all_cities = set(
                    k.title() for k in DEPARTURES.keys() 
                    if len(k) > 2 and not k.startswith("_")
                )
            except ImportError:
                all_cities = set()
            
            # Топ-7 популярных городов вылета
            top_cities = ["Москва", "Санкт-Петербург", "Екатеринбург", "Казань", "Новосибирск", "Краснодар", "Самара"]
            
            # Выбираем те, что есть в справочнике
            alternatives = [c for c in top_cities if c.lower() in [a.lower() for a in all_cities]][:7]
            
            # Fallback если справочник пустой или топ-города не найдены
            if not alternatives:
                alternatives = sorted(all_cities)[:7] if all_cities else top_cities
            
            alternatives_text = ", ".join(alternatives)
            
            state["response"] = (
                f"К сожалению, сейчас вылеты {from_city(user_city)} недоступны.\n\n"
                f"Доступные города вылета:\n"
                f"✈️ {alternatives_text}\n\n"
                f"Выберите город из списка — остальные параметры (направление, даты, туристы) сохранены."
            )
            state["awaiting_departure_selection"] = True  # Не продолжать каскад
            logger.info(f"   ✈️ FIX: Город вылета '{user_city}' недоступен → предложены альтернативы")
            return state
        
        # ==================== SMART RETRY FOR ZERO RESULTS ====================
        # Если strict date search вернул 0 результатов — автоматически расширяем диапазон
        if is_exact_date and (not result.found or not result.offers) and not is_strict:
            logger.info("   🔄 SMART RETRY: strict date вернул 0, расширяем до ±2 дней...")
            
            # Расширяем диапазон дат
            expanded_date_from = original_date_from - timedelta(days=2)
            expanded_date_to = original_date_from + timedelta(days=2)
            
            # Создаём новый запрос с расширенными датами
            # ШАГ 2 FIX: Передаём search_mode для hotel_only режима!
            retry_request = SearchRequest(
                adults=search_request.adults,
                children=search_request.children,
                destination=search_request.destination,
                hotel_name=search_request.hotel_name,
                stars=search_request.stars,
                date_from=expanded_date_from,
                date_to=expanded_date_to,
                nights=search_request.nights,
                food_type=search_request.food_type,
                departure_city=search_request.departure_city,
                services=search_request.services,
                hotel_types=search_request.hotel_types,
                tour_type=search_request.tour_type,
                search_mode=search_request.search_mode,  # ШАГ 2 FIX: сохраняем режим поиска!
            )
            
            retry_result = await tourvisor_service.search_tours(
                retry_request,
                is_strict_hotel_search=is_strict,
                hotel_ids=hotel_ids
            )
            
            if retry_result.found and retry_result.offers:
                result = retry_result
                state["date_warning"] = True  # Флаг для предупреждения в ответе
                logger.info(f"   ✅ SMART RETRY успешен: найдено {len(result.offers)} туров с ±2 дней")
        
        # ⛔ ОБРАБОТКА: Отель не найден в базе туроператоров
        if result.reason == "hotel_not_found_in_db":
            hotel_name = params.get("hotel_name", "указанный отель")
            country = params.get("destination_country", "этом регионе")
            state["tour_offers"] = []
            state["hotel_not_found"] = True
            state["response"] = (
                f"К сожалению, я не нашёл отель {hotel_name} {in_country(country)}.\n\n"
                f"Возможные причины:\n"
                f"• Отель не работает с туроператорами\n"
                f"• Отель закрыт на эти даты\n"
                f"• Название введено с ошибкой\n\n"
                f"Попробуйте уточнить название или посмотреть другие отели {in_country(country)}."
            )
            return state
        
        # ==================== FIX 2.3: ОБРАБОТКА ОТСУТСТВИЯ ПИТАНИЯ ====================
        # Если поиск вернул "no_tours_with_food_type" — сразу передаём в responder
        if result.reason == "no_tours_with_food_type":
            state["tour_offers"] = []
            state["search_reason"] = result.reason
            state["search_suggestion"] = result.suggestion  # Доступные типы питания
            logger.info(f"   🍽️ FIX 2.3: Питание '{result.suggestion}' недоступно → предлагаем альтернативы")
            return state
        
        # ==================== FIX: NO ROUTES FALLBACK ====================
        # Если departure и country валидны, но туров нет И нет жёстких фильтров
        # → скорее всего нет маршрута из этого города в это направление
        no_results = not result.found or not result.offers
        has_strict_filters = params.get("stars_explicit") or params.get("food_type_explicit") or params.get("hotel_name")
        departure_city = params.get("departure_city")
        dest_country = params.get("destination_country")
        
        # Проверяем: departure и country валидны (ID найдены), но результатов нет без жёстких фильтров
        if no_results and departure_city and dest_country and not has_strict_filters:
            # Проверяем что это не unknown_departure или unknown_country (уже обработаны выше)
            if result.reason not in ("unknown_departure", "unknown_country", "hotel_not_found_in_db"):
                state["tour_offers"] = []
                state["no_routes"] = True
                
                # Предлагаем альтернативные города вылета (популярные)
                try:
                    from app.core.tourvisor_constants import DEPARTURES
                    # Топ популярных городов (исключая текущий)
                    top_cities = ["Москва", "Санкт-Петербург", "Екатеринбург", "Казань", "Новосибирск", "Краснодар", "Самара"]
                    available_cities = [c for c in top_cities if c.lower() != departure_city.lower()][:5]
                except ImportError:
                    available_cities = ["Москва", "Санкт-Петербург", "Екатеринбург", "Казань", "Новосибирск"]
                
                # Предлагаем альтернативные направления
                top_destinations = ["Турция", "Египет", "ОАЭ", "Таиланд", "Мальдивы", "Шри-Ланка"]
                alt_destinations = [d for d in top_destinations if d.lower() != dest_country.lower()][:5]
                
                cities_text = ", ".join(available_cities)
                destinations_text = ", ".join(alt_destinations)
                
                state["response"] = (
                    f"К сожалению, сейчас {from_city(departure_city)} нет доступных туров {to_country(dest_country)}.\n\n"
                    f"Вы можете:\n"
                    f"✈️ Выбрать другой город вылета: {cities_text}\n"
                    f"🌴 Или другое направление: {destinations_text}\n\n"
                    f"Что предпочитаете? Остальные параметры (даты, туристы) сохранены."
                )
                state["awaiting_route_selection"] = True
                logger.info(f"   🛣️ FIX: Нет маршрута {departure_city} → {dest_country} → предложены альтернативы")
                return state
        
        # ==================== ШАГ 17: NO OFFERS UNIVERSAL FALLBACK ====================
        # Направление валидно (country_id найден), но туров нет — универсальный fallback
        # Условия: no_results AND destination_country валидна (ID есть) AND NOT (hotel_name_explicit)
        # AND NOT уже обработано (unknown_country/unknown_departure/no_routes)
        if no_results and dest_country:
            # Проверяем что страна валидна (есть ID)
            country_id = tourvisor_service.get_country_id(dest_country)
            is_valid_country = country_id is not None
            
            # Исключаем случаи, которые уже обработаны выше или будут обработаны ниже
            already_handled = (
                state.get("unknown_country") or 
                state.get("unknown_departure") or 
                state.get("no_routes") or
                state.get("hotel_not_found") or
                params.get("hotel_name_explicit")  # hotel_name обрабатывается отдельно (Шаг 16 + P5)
            )
            
            if is_valid_country and not already_handled:
                state["tour_offers"] = []
                state["no_offers_valid_destination"] = True
                
                # Получаем альтернативы из справочников
                try:
                    from app.core.tourvisor_constants import COUNTRIES, DEPARTURES
                    
                    # Альтернативные направления (из COUNTRIES, сортировка по id стабильная)
                    all_countries = sorted(
                        [(name.title(), cid) for name, cid in COUNTRIES.items()],
                        key=lambda x: x[1]
                    )
                    # Исключаем текущее направление, берём первые 7
                    alt_destinations = [
                        name for name, cid in all_countries 
                        if name.lower() != dest_country.lower()
                    ][:7]
                    
                    # ШАГ 17.1: Альтернативные города вылета (приоритетные хабы)
                    from app.utils.ru_text import get_preferred_departures
                    alt_cities = get_preferred_departures(
                        DEPARTURES,
                        exclude_city=departure_city,
                        limit=5
                    )
                    
                except ImportError:
                    alt_destinations = ["Турция", "Египет", "ОАЭ", "Таиланд", "Мальдивы"]
                    alt_cities = ["Москва", "Санкт-Петербург", "Екатеринбург"]
                
                # Формируем ответ в зависимости от наличия strict filters
                dest_text = to_country(dest_country)
                dep_text = from_city(departure_city) if departure_city else ""
                
                if has_strict_filters:
                    # Есть жёсткие фильтры — предлагаем изменить условия
                    filter_hints = []
                    if params.get("stars_explicit"):
                        filter_hints.append("звёздность")
                    if params.get("food_type_explicit"):
                        filter_hints.append("тип питания")
                    filter_text = ", ".join(filter_hints) if filter_hints else "условия"
                    
                    state["response"] = (
                        f"К сожалению, сейчас нет доступных туров {dest_text} {dep_text} с указанными критериями.\n\n"
                        f"Попробуйте:\n"
                        f"• Изменить {filter_text}\n"
                        f"• Сдвинуть даты на несколько дней\n"
                        f"• Или выбрать другое направление: {', '.join(alt_destinations[:5])}\n\n"
                        f"Что предпочитаете? Остальные параметры сохранены."
                    )
                else:
                    # Нет жёстких фильтров — предлагаем альтернативные направления
                    destinations_text = ", ".join(alt_destinations)
                    cities_text = ", ".join(alt_cities) if alt_cities else ""
                    
                    response_parts = [
                        f"К сожалению, сейчас нет доступных туров {dest_text} {dep_text} на ваши даты."
                    ]
                    
                    if destinations_text:
                        response_parts.append(f"\n\nМогу предложить альтернативные направления: {destinations_text}")
                    
                    if cities_text and departure_city:
                        response_parts.append(f"\n\nИли выбрать другой город вылета: {cities_text}")
                    
                    response_parts.append("\n\nЧто предпочитаете? Остальные параметры сохранены.")
                    
                    state["response"] = "".join(response_parts)
                
                state["awaiting_destination_selection"] = True
                logger.info(f"   🌍 ШАГ17: Нет туров {dest_country} (valid country_id={country_id}) → универсальный fallback")
                return state
        
        # === СОХРАНЯЕМ ДАННЫЕ ДЛЯ ПАГИНАЦИИ (GAP Analysis) ===
        if result.search_id:
            state["last_search_id"] = result.search_id
            state["last_country_id"] = tourvisor_service.get_country_id(destination.country)
            state["current_page"] = 1
            state["has_more_results"] = result.total_found > 5  # Есть ли ещё туры
        
        # ==================== P5 FIX: ПРОВЕРКА ДОСТУПНЫХ ТИПОВ ПИТАНИЯ ====================
        # Если отель указан, питание указано явно, но туров нет — проверяем какое питание есть
        # УСЛОВИЯ: hotel_name + food_type_explicit + 0 результатов
        hotel_name_param = params.get("hotel_name")
        food_type_explicit = params.get("food_type_explicit", False)
        no_results_with_food = (not result.found or not result.offers) and hotel_name_param and food_type_explicit
        
        if no_results_with_food and found_hotel_info and not state.get("alt_food_checked"):
            requested_food = params.get("food_type")
            logger.info(f"   🍽️ P5: Проверяем доступное питание для {hotel_name_param} (запрошено: {requested_food})")
            
            try:
                # Поиск БЕЗ фильтра по питанию — узнаём что есть
                alt_food_request = SearchRequest(
                    adults=params.get("adults", 2),
                    children=params.get("children", []),
                    destination=destination,
                    hotel_name=hotel_name_param,  # Тот же отель
                    stars=params.get("stars"),
                    date_from=date_from,
                    date_to=date_to,
                    food_type=None,  # БЕЗ фильтра по питанию!
                    departure_city=params.get("departure_city", "Москва")
                )
                
                alt_food_result = await tourvisor_service.search_tours(
                    alt_food_request,
                    is_strict_hotel_search=True,
                    hotel_ids=[found_hotel_info.hotel_id] if found_hotel_info else None
                )
                
                state["alt_food_checked"] = True  # Помечаем что проверили
                
                if alt_food_result.found and alt_food_result.offers:
                    # Есть туры с ДРУГИМ питанием! Извлекаем доступные типы
                    available_foods = set()
                    for offer in alt_food_result.offers:
                        if hasattr(offer, "food_type") and offer.food_type:
                            food_val = offer.food_type.value if hasattr(offer.food_type, "value") else str(offer.food_type)
                            available_foods.add(food_val)
                    
                    if available_foods:
                        # Убираем запрошенный тип (его нет)
                        requested_val = requested_food.value if hasattr(requested_food, "value") else str(requested_food)
                        available_foods.discard(requested_val)
                        
                        if available_foods:
                            # Есть другие типы питания!
                            food_names = {
                                "AI": "Всё включено",
                                "UAI": "Ультра Всё включено",
                                "FB": "Полный пансион",
                                "HB": "Полупансион",
                                "BB": "Завтраки",
                                "RO": "Без питания"
                            }
                            available_list = [food_names.get(f, f) for f in sorted(available_foods)]
                            logger.info(f"   🍽️ P5: В отеле доступно: {available_list}")
                            
                            state["available_food_types"] = list(available_foods)
                            state["available_food_for_hotel"] = hotel_name_param
                            state["tour_offers"] = []  # Пока не показываем туры
                            state["response"] = (
                                f"В отеле {hotel_name_param} на эти даты питание «{food_names.get(requested_val, requested_val)}» недоступно.\n\n"
                                f"Доступные варианты: {', '.join(available_list)}.\n\n"
                                f"Показать туры с другим питанием?"
                            )
                            state["awaiting_agreement"] = True
                            state["pending_action"] = "alt_food_hotel"
                            return state
            except Exception as e:
                logger.warning(f"   ⚠️ P5: Ошибка проверки альтернативного питания: {e}")
                # Продолжаем стандартный flow
        
        # ==================== SMART ALTERNATIVES ====================
        # Если отель найден в справочнике, но туров нет — ищем альтернативы!
        if is_strict and found_hotel_info and (not result.found or not result.offers):
            # Туров в конкретный отель нет — ищем альтернативы
            hotel_stars = found_hotel_info.stars or 5
            # HotelInfo использует region_name, не region
            hotel_region = getattr(found_hotel_info, 'region_name', '') or getattr(found_hotel_info, 'resort_name', '')
            hotel_display_name = found_hotel_info.name
            
            # Создаём запрос для поиска альтернатив (по региону и звёздности)
            alt_search_request = SearchRequest(
                adults=params.get("adults"),  # Без дефолта!
                children=params.get("children", []),
                destination=Destination(
                    country=params.get("destination_country"),
                    region=hotel_region  # Тот же регион
                ),
                stars=hotel_stars,  # Те же звёзды
                date_from=date_from,
                date_to=date_to,
                food_type=params.get("food_type"),
                departure_city=params.get("departure_city", "Москва")
            )
            
            # Поиск альтернатив (БЕЗ строгого фильтра по отелю)
            alt_result = await tourvisor_service.search_tours(
                alt_search_request,
                is_strict_hotel_search=False,
                hotel_ids=None
            )
            
            if alt_result.found and alt_result.offers:
                # Исключаем исходный отель из альтернатив
                filtered_offers = [
                    offer for offer in alt_result.offers
                    if offer.hotel_name.lower() != hotel_display_name.lower()
                ][:5]
                
                if filtered_offers:
                    state["tour_offers"] = filtered_offers
                    state["smart_alternatives"] = True
                    state["original_hotel_name"] = hotel_display_name
                    state["original_hotel_stars"] = hotel_stars
                    state["original_hotel_region"] = hotel_region or country_for_hotel
                else:
                    # Альтернатив тоже нет
                    state["tour_offers"] = []
                    state["no_alternatives"] = True
            else:
                # Альтернатив нет
                state["tour_offers"] = []
                state["no_alternatives"] = True
                state["search_reason"] = result.reason
                state["search_suggestion"] = result.suggestion
        else:
            # ==================== P5 ENHANCED: Проверка совпадения питания ====================
            # Если туры найдены, но питание указано явно — проверяем совпадает ли
            if result.found and result.offers and params.get("food_type_explicit") and params.get("hotel_name"):
                requested_food = params.get("food_type")
                if requested_food and not state.get("alt_food_checked"):
                    requested_val = requested_food.value if hasattr(requested_food, "value") else str(requested_food)
                    
                    # Проверяем, есть ли хоть один тур с запрошенным питанием
                    matching_offers = []
                    other_food_offers = []
                    
                    for offer in result.offers:
                        if hasattr(offer, "food_type") and offer.food_type:
                            offer_food = offer.food_type.value if hasattr(offer.food_type, "value") else str(offer.food_type)
                            if offer_food == requested_val:
                                matching_offers.append(offer)
                            else:
                                other_food_offers.append(offer)
                        else:
                            other_food_offers.append(offer)
                    
                    # Если НЕТ туров с запрошенным питанием, но ЕСТЬ с другим
                    if not matching_offers and other_food_offers:
                        logger.info(f"   🍽️ P5 ENHANCED: Найдено {len(other_food_offers)} туров, но НЕ с питанием {requested_val}")
                        
                        # Извлекаем доступные типы питания
                        available_foods = set()
                        for offer in other_food_offers:
                            if hasattr(offer, "food_type") and offer.food_type:
                                food_val = offer.food_type.value if hasattr(offer.food_type, "value") else str(offer.food_type)
                                available_foods.add(food_val)
                        
                        if available_foods:
                            food_names = {
                                "AI": "Всё включено",
                                "UAI": "Ультра Всё включено",
                                "FB": "Полный пансион",
                                "HB": "Полупансион",
                                "BB": "Завтраки",
                                "RO": "Без питания"
                            }
                            available_list = [food_names.get(f, f) for f in sorted(available_foods)]
                            hotel_name_param = params.get("hotel_name")
                            
                            state["alt_food_checked"] = True
                            state["available_food_types"] = list(available_foods)
                            state["available_food_for_hotel"] = hotel_name_param
                            state["tour_offers"] = []  # Пока не показываем
                            # ШАГ 16: Ответ с hotel_name, без кавычек
                            state["response"] = (
                                f"К сожалению, в {hotel_name_param} на эти даты "
                                f"питание {food_names.get(requested_val, requested_val)} недоступно.\n\n"
                                f"На эти даты доступно: {', '.join(available_list)}.\n\n"
                                f"Хотите посмотреть туры с этим питанием, или подобрать другой отель/даты?"
                            )
                            state["awaiting_agreement"] = True
                            state["pending_action"] = "alt_food_hotel"
                            logger.info(f"   🍽️ P5 ENHANCED: Предлагаем альтернативы: {available_list}")
                            return state
                    
                    # Если есть туры с нужным питанием — показываем только их
                    elif matching_offers:
                        logger.info(f"   🍽️ P5 ENHANCED: {len(matching_offers)} туров с питанием {requested_val}")
                        state["tour_offers"] = matching_offers
                        return state
            
            # Стандартное сохранение результатов
            state["tour_offers"] = result.offers if result.found else []
            
            if not result.found:
                state["search_reason"] = result.reason
                state["search_suggestion"] = result.suggestion
        
    except Exception as e:
        state["error"] = f"Ошибка поиска: {str(e)}"
        state["tour_offers"] = []
    
    return state


def generate_no_results_explanation(params: PartialSearchParams, state: AgentState = None) -> tuple[str, bool, str]:
    """
    Генерирует умное объяснение, почему нет результатов.
    Учитывает количество попыток для предотвращения зацикливания.
    
    GAP Analysis: Добавлен Smart Fallback по типу питания (AI -> HB).
    P1: Запрет "проверил" без фактического API вызова.
    
    Returns:
        tuple: (текст ответа, нужно ли ждать согласия, тип предложенного действия)
    """
    country = params.get("destination_country", "")
    date_from = params.get("date_from")
    departure_city = params.get("departure_city", "")
    food_type = params.get("food_type")
    stars = params.get("stars")
    # ШАГ 16: hotel_name для персонализации ответов
    hotel_name = params.get("hotel_name") if params.get("hotel_name_explicit") else None
    
    # Получаем счётчик попыток и диапазон дат из state
    search_attempts = state.get("search_attempts", 0) if state else 0
    flex_days = state.get("flex_days", 2) if state else 2
    flex_search_done = state.get("flex_search", False) if state else False
    offered_alt_departure = state.get("offered_alt_departure", False) if state else False
    offered_alt_food = state.get("offered_alt_food", False) if state else False
    offered_lower_stars = state.get("offered_lower_stars", False) if state else False
    
    # === P1: ЗАПРЕТ "проверил" БЕЗ ФАКТИЧЕСКОГО API ВЫЗОВА ===
    api_call_made = state.get("api_call_made", False) if state else False
    if not api_call_made:
        # Нет API вызова — не можем говорить "проверил"
        # FIX P3: Улучшенная диагностика — показываем что именно не хватает
        missing = state.get("missing_info", []) if state else []
        logger.warning(f"   ⚠️ P1: НЕТ api_call_made — missing_info={missing}")
        
        if missing:
            param_names = {
                "departure_city": "город вылета",
                "adults": "количество человек",
                "nights": "количество ночей",
                "destination_country": "страна",
                "date_from": "даты"
            }
            missing_text = ", ".join(param_names.get(m, m) for m in missing)
            return (
                f"Для поиска нужно уточнить: {missing_text}.",
                False,
                None
            )
        
        return (
            "Не удалось выполнить поиск. Пожалуйста, уточните параметры: даты, город вылета и направление.",
            False,
            None
        )
    
    if date_from:
        date_str = date_from.strftime("%d.%m")
        
        # Первая попытка — предлагаем расширить диапазон дат
        if not flex_search_done and search_attempts <= 1:
            response = f"На {date_str} вылетов из {departure_city} нет. Посмотреть соседние даты?"
            return (response, True, "flex_dates")
        
        # === SMART FALLBACK: ПО ТИПУ ПИТАНИЯ (GAP Analysis) ===
        # Если было указано AI/UAI — предлагаем HB или FB
        # ШАГ 16: Если hotel_name задан, упоминаем его в ответе
        if food_type and food_type.value in ("AI", "UAI") and not offered_alt_food:
            food_name = "Всё включено" if food_type.value == "AI" else "Ультра Всё включено"
            if hotel_name:
                # ШАГ 16: Универсальный ответ с hotel_name (без кавычек)
                response = (
                    f"В {hotel_name} питание {food_name} на эти даты недоступно.\n"
                    f"Посмотреть с Полупансион (HB: завтрак + ужин)?"
                )
            else:
                response = (
                    f"С питанием {food_name} вариантов нет.\n"
                    f"Посмотреть с Полупансион (HB: завтрак + ужин)?"
                )
            return (response, True, "alt_food")
        
        # === SMART FALLBACK: ПО ЗВЁЗДНОСТИ ===
        # Если было указано 5* — предлагаем 4*
        # ШАГ 16: Если hotel_name задан, не говорим "отелей нет" (отель указан конкретно)
        if stars and stars >= 5 and not offered_lower_stars:
            if hotel_name:
                # ШАГ 16: Для конкретного отеля звёзды фиксированы, не спрашиваем
                pass  # Пропускаем, звёзды для конкретного отеля не релевантны
            else:
                response = (
                    f"Отелей {stars}⭐ на эти даты нет.\n"
                    f"Посмотреть 4⭐ отели?"
                )
                return (response, True, "lower_stars")
        
        # Вторая попытка (после расширения дат) — если город не Москва, предлагаем Москву
        if flex_search_done and departure_city.lower() != "москва" and not offered_alt_departure:
            # Рассчитываем диапазон, который проверили
            from_date = (date_from - timedelta(days=flex_days)).strftime("%d.%m")
            to_date = (date_from + timedelta(days=flex_days)).strftime("%d.%m")
            response = (
                f"Я проверил даты с {from_date} по {to_date}, но рейсов из {departure_city} нет.\n"
                f"Попробовать вылет из Москвы?"
            )
            return (response, True, "alt_departure")
        
        # Финальное сообщение — не задаём вопрос, предотвращаем цикл
        from_date = (date_from - timedelta(days=flex_days)).strftime("%d.%m")
        to_date = (date_from + timedelta(days=flex_days)).strftime("%d.%m")
        response = (
            f"Я проверил все варианты с {from_date} по {to_date}.\n"
            f"К сожалению, рейсов нет. Попробуйте сдвинуть отпуск на неделю или выбрать другое направление."
        )
        return (response, False, None)  # НЕ ждём согласия — предотвращаем цикл
    
    # Дефолтный ответ без зацикливания
    return (
        "По запросу туров не найдено. Попробуйте изменить даты или направление.",
        False,
        None
    )


async def responder(state: AgentState) -> AgentState:
    """
    Формирование ответа.
    
    Ключевые правила:
    - Приветствие только один раз
    - Каскад вопросов в правильном порядке
    - Умное объяснение "нет результатов"
    """
    # КРИТИЧНО: Если ответ уже был установлен (например, hotel_not_found) — не перезаписываем
    if state.get("hotel_not_found") and state.get("response"):
        return state
    
    # P5 ENHANCED: Если уже предложили альтернативное питание — не перезаписываем ответ
    if state.get("pending_action") == "alt_food_hotel" and state.get("response"):
        return state
    
    # P5 FIX: Если ответ уже установлен и это переходный вопрос — не перезаписываем
    # Это нужно когда пользователь выбирает "другой отель" или "другие даты"
    if state.get("response") and (
        "подберём другой" in state.get("response", "") or
        "попробуем другие даты" in state.get("response", "")
    ):
        return state
    
    # ==================== FIX: UNKNOWN DEPARTURE/COUNTRY/ROUTES GUARD ====================
    # Если tour_searcher уже сформировал ответ для unknown_departure, unknown_country или no_routes
    # — не перезаписываем его в responder
    if state.get("unknown_departure") and state.get("response"):
        logger.info("   🛡️ GUARD: unknown_departure response preserved")
        return state
    
    if state.get("unknown_country") and state.get("response"):
        logger.info("   🛡️ GUARD: unknown_country response preserved")
        return state
    
    if state.get("no_routes") and state.get("response"):
        logger.info("   🛡️ GUARD: no_routes response preserved")
        return state
    
    # Ошибка
    if state.get("error"):
        state["response"] = f"Произошла ошибка: {state['error']}. Попробуйте ещё раз."
        return state
    
    params = state["search_params"]
    cascade_stage = get_cascade_stage(params, state.get("search_mode", "package"))
    is_first = state.get("is_first_message", False) and not state.get("greeted", False)
    
    # Найденные туры — новый формат с подтверждением
    if state["tour_offers"]:
        offers = state["tour_offers"]
        country = params.get("destination_country", "")
        hotel_name = params.get("hotel_name", "")
        date_from = params.get("date_from")
        
        # Формируем краткий контекст для заголовка
        date_str = date_from.strftime("%d.%m") if date_from else ""
        
        # ==================== SMART ALTERNATIVES RESPONSE ====================
        if state.get("smart_alternatives"):
            # Это альтернативы, а не исходный отель!
            original_hotel = state.get("original_hotel_name", hotel_name)
            original_stars = state.get("original_hotel_stars", 5)
            original_region = state.get("original_hotel_region", country)
            
            header = (
                f"К сожалению, в {original_hotel} на эти даты туров нет (места закончились).\n\n"
                f"Но я подобрал похожие варианты {original_stars}★ в регионе {original_region}:"
            )
        else:
            # Обычная выдача
            if hotel_name:
                header = f"Вот туры в {hotel_name}"
            else:
                header = f"Вот варианты в {country}"
            
            if date_str:
                header += f" на {date_str}"
            header += ":"
        
        # ==================== NIGHTS RANGE INFO ====================
        # Информируем пользователя о диапазоне ночей (+1 для лучшего покрытия)
        nights_info = ""
        nights = params.get("nights")
        if nights and nights > 0:
            nights_to = nights + 1
            nights_info = f"\n📅 Показаны туры на {nights}-{nights_to} ночей"
        
        # ==================== DATE WARNING (Smart Retry) ====================
        # Если strict date search вернул 0 и мы расширили диапазон — предупреждаем пользователя
        date_warning = ""
        if state.get("date_warning"):
            original_date = state.get("original_date_from")
            if original_date:
                date_warning = f"\n⚠️ На точную дату {original_date.strftime('%d.%m')} рейсов не найдено, показываю ближайшие варианты (±2 дня).\n"
            else:
                date_warning = "\n⚠️ На указанную точную дату рейсов не найдено, показываю ближайшие варианты (±2 дня).\n"
            # Сбрасываем флаг
            state["date_warning"] = False
        
        # ==================== P3 FIX: GROUP WARNING (7-9 человек) ====================
        group_warning = ""
        if state.get("group_warning"):
            group_size = state.get("group_size", 0)
            group_warning = (
                f"\n👥 Для группы из {group_size} человек рекомендуем связаться с менеджером "
                f"для получения специальных условий и скидок.\n"
                f"Телефон: +7 (495) 123-45-67\n"
            )
            # НЕ сбрасываем флаг — он сохранится в сессии
        
        # ЭТАП 4: Убраны непрошенные рекомендации о сезоне
        # Клиент не просил совета о погоде — не даём лишнюю информацию
        # (было: предупреждение "море прохладное для купания")
        
        state["response"] = header + nights_info + date_warning + group_warning
        # Сбрасываем флаги ожидания
        state["awaiting_agreement"] = False
        state["pending_action"] = None
        return state
    
    # ==================== P4 FIX: ГОРЯЩИЕ ТУРЫ — ТЕ ЖЕ КРИТЕРИИ ====================
    # По требованию коллег: собираем те же критерии, что и для обычных туров!
    # Отличие: даты/ночи устанавливаются автоматически (ближайшие 7 дней)
    is_hot_tour = params.get("is_hot_tour", False) or state.get("intent") == "hot_tours"
    
    if is_hot_tour:
        logger.info("🔥 P4: Горящие туры — собираем критерии как для обычных туров")
        
        # P4 FIX: ВАЖНО! Сохраняем флаг is_hot_tour в search_params
        params["is_hot_tour"] = True
        state["intent"] = "hot_tours"  # Также сохраняем intent
        
        # P4 FIX: Устанавливаем дефолтные даты для горящих (чтобы пройти каскад)
        if not params.get("date_from"):
            params["date_from"] = date.today() + timedelta(days=1)
            params["date_to"] = date.today() + timedelta(days=7)
            params["nights"] = 7
        # HOT FIX: dates_confirmed ОБЯЗАТЕЛЬНО для cascade (иначе вернёт stage=3)
        params["dates_confirmed"] = True
        
        state["search_params"] = params
        
        # P4 FIX: НЕ пропускаем каскад — продолжаем собирать adults/stars/food_type
        # Cascade продолжится ниже
    
    # КАСКАД ВОПРОСОВ (строгий порядок)
    # P4 FIX: Горящие туры теперь проходят полный каскад (кроме дат)
    
    # ==================== ФОРМИРОВАНИЕ КОНТЕКСТА ====================
    # Собираем что УЖЕ знаем для подтверждения в ответе
    hotel_name = params.get("hotel_name", "")
    country = params.get("destination_country", "")
    departure = params.get("departure_city", "")
    date_from = params.get("date_from")
    date_str = date_from.strftime("%d.%m") if date_from else ""
    adults = params.get("adults", 0)
    
    # Формируем подтверждение понятого
    confirmation_parts = []
    if hotel_name:
        confirmation_parts.append(f"отель {hotel_name}")
    if country and not hotel_name:
        confirmation_parts.append(country)
    if date_str:
        confirmation_parts.append(f"на {date_str}")
    if adults:
        confirmation_parts.append(f"на {adults} чел.")
    
    confirmation = ", ".join(confirmation_parts) if confirmation_parts else ""
    
    # Этап 1: нужна страна
    if cascade_stage == 1:
        # ==================== АНТИ-ПОВТОРНОЕ ПРИВЕТСТВИЕ ====================
        # КРИТИЧНО: Если в истории > 2 сообщений — НЕ используем стартовое приветствие!
        messages_count = len(state.get("messages", []))
        already_greeted = state.get("greeted", False)
        
        # FIX P5: Умный вопрос при наличии отеля без страны
        if hotel_name and not params.get("destination_country"):
            state["response"] = f"В какой стране смотрим {hotel_name}? (Турция, ОАЭ, Египет...)"
            state["last_question_type"] = "destination_country"
            logger.info(f"   🏨 FIX P5: Отель {hotel_name} без страны → умный вопрос")
            return state
        
        if is_first and not already_greeted and messages_count <= 2:
            # Первое сообщение — сразу к делу, без "Здравствуйте"
            state["response"] = "В какую страну планируете поездку?"
            state["greeted"] = True
        else:
            # В середине диалога — кратко и по делу
            state["response"] = "В какую страну планируете поездку?"
        return state
    
    # Этап 2: нужен город вылета — кратко и по делу
    if cascade_stage == 2:
        # PR3: Anti-loop detection
        question_repeat = state.get("question_repeat_count", 0)
        if question_repeat >= 3:
            state["response"] = "Давайте я подключу менеджера — он поможет с выбором. Оставьте ваш телефон, и мы перезвоним."
            state["awaiting_phone"] = True
            state["last_question_type"] = "phone"
            return state
        elif question_repeat >= 2:
            state["response"] = "Уточните, пожалуйста: из какого города вы хотели бы вылететь? Например: Москва, Санкт-Петербург, Казань..."
        else:
            state["response"] = "Из какого города вылет?"
        state["last_question_type"] = "departure_city"  # P4 FIX: для защиты destination
        state["last_asked_question_type"] = "departure_city"  # PR3: для anti-loop tracking
        return state
    
    # Этап 3: нужны даты — кратко и по делу
    # P4 FIX: Для горящих туров пропускаем только даты, но собираем остальное!
    if cascade_stage == 3:
        is_hot = params.get("is_hot_tour", False) or state.get("intent") == "hot_tours"
        if is_hot:
            # P4 FIX: Горящие туры — дата не нужна, но проверяем adults
            logger.info("🔥 P4: Горящие туры — пропускаем даты, проверяем adults")
            # ВАЖНО: Сохраняем флаг is_hot_tour
            params["is_hot_tour"] = True
            # Устанавливаем дефолтные даты для горящих (следующие 7 дней)
            if not params.get("date_from"):
                params["date_from"] = date.today() + timedelta(days=1)
                params["date_to"] = date.today() + timedelta(days=7)
                params["nights"] = 7
                params["dates_confirmed"] = True  # HOT FIX: Подтверждаем даты для cascade
            state["search_params"] = params
            state["intent"] = "hot_tours"  # Сохраняем intent
            # HOT FIX: ПЕРЕСЧИТЫВАЕМ cascade_stage после установки дат!
            # Без этого локальная переменная остаётся = 3 и проверки cascade_stage == 4 не срабатывают
            cascade_stage = get_cascade_stage(params, state.get("search_mode", "package"))
            state["cascade_stage"] = cascade_stage
            logger.info(f"🔥 P4: Пересчитан cascade_stage = {cascade_stage}")
            # НЕ return — продолжаем каскад с новым cascade_stage
        else:
            # ==================== FIX 6.1: MONTH-ONLY CHECK (STAGE 3) ====================
            # Если пользователь указал месяц, но не конкретную дату — уточняем
            date_precision = params.get("date_precision")
            if date_precision == "month" and not params.get("dates_confirmed"):
                detected_month = params.get("detected_month")
                month_names = {
                    1: "января", 2: "февраля", 3: "марта", 4: "апреля",
                    5: "мая", 6: "июня", 7: "июля", 8: "августа",
                    9: "сентября", 10: "октября", 11: "ноября", 12: "декабря"
                }
                month_name = month_names.get(detected_month, "месяца")
                state["response"] = f"Какого числа {month_name} планируете вылет?"
                state["last_question_type"] = "dates"
                logger.info(f"   📅 FIX 6.1: Month-only ({month_name}) — спрашиваем конкретную дату (stage 3)")
                return state
            
            state["response"] = "Когда планируете вылет?"
            return state
    
    # --- ЭТАП 4: HARD VALIDATION (Критические параметры) ---
    # Без этих данных поиск технически невозможен или даст неверную цену.
    # Это "Жесткий барьер" — флаги типа clarification_asked здесь НЕ работают!
    if cascade_stage == 4:
        adults_explicit = params.get("adults_explicit", False)
        has_adults = params.get("adults") and adults_explicit
        has_nights = params.get("nights")
        
        # ==================== 1. ПРОВЕРКА НАПРАВЛЕНИЯ (RIXOS FIX) ====================
        # Если отель указан → ПРОПУСКАЕМ вопрос о стране (страну подтянем из поиска)
        if not params.get("destination_country") and not params.get("hotel_name"):
            state["response"] = "В какую страну или город вы планируете поездку?"
            state["last_question_type"] = "destination"
            return state
        
        # ==================== 2. ПРОВЕРКА ДАТ ====================
        # ==================== FIX 6.1: MONTH-ONLY ПРОВЕРКА ПЕРВОЙ ====================
        # ВАЖНО: Эта проверка должна быть ДО проверки date_from!
        # Потому что date_from устанавливается даже для month-only дат
        date_precision = params.get("date_precision")
        if date_precision == "month" and not params.get("dates_confirmed"):
            detected_month = params.get("detected_month")
            month_names = {
                1: "января", 2: "февраля", 3: "марта", 4: "апреля",
                5: "мая", 6: "июня", 7: "июля", 8: "августа",
                9: "сентября", 10: "октября", 11: "ноября", 12: "декабря"
            }
            month_name = month_names.get(detected_month, "месяца")
            state["response"] = f"Какого числа {month_name} планируете вылет?"
            state["last_question_type"] = "dates"
            logger.info(f"   📅 FIX 6.1: Month-only ({month_name}) — спрашиваем конкретную дату")
            return state
        
        # ==================== 2. ПРОВЕРКА ДАТ ====================
        if not params.get("date_from"):
            # PR3: Anti-loop detection
            question_repeat = state.get("question_repeat_count", 0)
            if question_repeat >= 3:
                state["response"] = "Давайте я подключу менеджера для помощи с датами. Оставьте телефон, и мы перезвоним."
                state["awaiting_phone"] = True
                state["last_question_type"] = "phone"
                return state
            elif question_repeat >= 2:
                state["response"] = "Укажите дату вылета. Например: «15 июня», «в середине мая» или «на майские праздники»."
            elif hotel_name:
                state["response"] = f"На какие даты смотрим {hotel_name}?"
            else:
                state["response"] = "На какие даты планируете вылет?"
            state["last_question_type"] = "dates"
            state["last_asked_question_type"] = "dates"  # PR3: для anti-loop tracking
            return state
        
        # ==================== 3. ПРОВЕРКА НОЧЕЙ ====================
        if not has_nights:
            # PR3: Anti-loop detection
            question_repeat = state.get("question_repeat_count", 0)
            if question_repeat >= 3:
                state["response"] = "Давайте я подключу менеджера. Оставьте телефон, и мы перезвоним для уточнения деталей."
                state["awaiting_phone"] = True
                state["last_question_type"] = "phone"
                return state
            elif question_repeat >= 2:
                state["response"] = "Укажите количество ночей цифрой. Например: «7 ночей», «10 дней» или «на неделю»."
            else:
                state["response"] = "На сколько ночей планируете поездку?"
            state["last_question_type"] = "nights"
            state["last_asked_question_type"] = "nights"  # PR3: для anti-loop tracking
            return state
        
        # ==================== 4. ПРОВЕРКА СОСТАВА (CHILDREN FIX) ====================
        # КРИТИЧНО: Нельзя искать, не зная ПОЛНЫЙ состав!
        children_ages = params.get("children", [])  # Список возрастов
        children_mentioned = params.get("children_mentioned")  # None = мы не знаем, есть ли дети
        children_count_mentioned = params.get("children_count_mentioned", 0)
        
        # Вариант A: adults не указан явно → спрашиваем
        # R4 FIX: Если дети уже известны — спрашиваем ТОЛЬКО про взрослых
        if not has_adults:
            # PR3: Anti-loop detection
            question_repeat = state.get("question_repeat_count", 0)
            if question_repeat >= 3:
                state["response"] = "Похоже, у нас возникли сложности. Давайте я подключу менеджера — оставьте телефон, и мы перезвоним."
                state["awaiting_phone"] = True
                state["last_question_type"] = "phone"
                return state
            elif question_repeat >= 2:
                state["response"] = "Пожалуйста, укажите количество человек цифрой. Например: «2 взрослых» или «2 взрослых, ребёнок 7 лет»."
            elif children_ages:
                # Дети известны — формируем умный вопрос только про взрослых
                kids_text = ", ".join(str(a) + " лет" for a in children_ages)
                state["response"] = f"Вижу {len(children_ages)} детей ({kids_text}). Сколько взрослых поедет?"
                logger.info(f"   R4 FIX: Дети известны {children_ages}, спрашиваем только про взрослых")
            else:
                # Ничего не знаем — спрашиваем полный состав
                state["response"] = "Сколько человек поедет? Укажите взрослых и детей (если есть — с возрастом)."
            state["last_question_type"] = "adults"
            state["last_asked_question_type"] = "adults"  # PR3: для anti-loop tracking
            return state
        
        # Вариант B: adults указан, но мы НЕ ЗНАЕМ про детей (children_mentioned is None)
        # И пользователь не сказал явно "один" или "без детей"
        no_children_phrases = params.get("no_children_explicit", False)  # "без детей", "только взрослые"
        all_adults = params.get("all_adults", False)  # FIX CASE-009: "X взрослых" → все взрослые
        
        if not no_children_phrases and children_mentioned is None and not children_ages:
            adults = params.get("adults", 0)
            is_group = params.get("group_warning", False) or adults >= 4
            
            # ==================== GUARD A (FIX CASE-009) ====================
            # Если пользователь ЯВНО сказал "X взрослых" (all_adults=True) → НЕ спрашиваем про детей
            if all_adults:
                logger.info(f"   🛡️ GUARD A (CASE-009): all_adults=True → пропускаем вопрос про детей")
                pass  # Не спрашиваем, идём дальше
            # ==================== GUARD B (FIX CASE-012) ====================
            # Если "X человек" (all_adults=False) → сначала уточняем состав (взрослые/дети)
            elif all_adults is False and adults >= 2:
                state["response"] = f"Сколько из {adults} — взрослых, и сколько детей? Если дети едут — укажите их возраст."
                state["last_question_type"] = "adults"  # Спрашиваем состав, не children_check
                logger.info(f"   🛡️ GUARD B (CASE-012): all_adults=False, {adults} человек → уточняем состав")
                return state
            elif adults == 1:
                # "я один" — вероятно без детей, пропускаем вопрос
                pass
            elif is_group:
                # FIX P4: Для групп 4+ ВСЕГДА уточняем состав детей
                state["response"] = f"Вас {adults} человек. Едут ли с вами дети? Если да — укажите возраст каждого."
                state["last_question_type"] = "children_check"
                logger.info(f"   👨‍👩‍👧 FIX P4: Группа {adults} чел. — спрашиваем про детей")
                return state
            else:
                # 2-3 взрослых — возможно семья с детьми
                state["response"] = "Поедут ли с вами дети? Если да — укажите их возраст."
                state["last_question_type"] = "children_check"
                return state
        
        # ==================== 5. ПРОВЕРКА ДЕТЕЙ БЕЗ ВОЗРАСТА (КРИТИЧНО ПО ТЗ!) ====================
        # Если бот понял, что есть дети, но не знает возраст — СТОП.
        if children_mentioned and not children_ages:
            if children_count_mentioned == 1:
                state["response"] = "Укажите, пожалуйста, возраст ребёнка (это важно для расчёта цены)."
            elif children_count_mentioned > 1:
                state["response"] = f"Укажите, пожалуйста, возраст всех {children_count_mentioned} детей (это важно для расчёта цены)."
            else:
                state["response"] = "Укажите, пожалуйста, возраст детей (это важно для расчёта цены)."
            state["last_question_type"] = "children_ages"
            return state
        
        # Если количество возрастов меньше чем упомянуто детей
        if children_count_mentioned > len(children_ages):
            missing = children_count_mentioned - len(children_ages)
            state["response"] = f"Вы упомянули {children_count_mentioned} детей, но указали возраст только для {len(children_ages)}. Укажите возраст остальных."
            state["last_question_type"] = "children_ages"
            return state
        
        # ==================== ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ ====================
        # Переход к Soft Clarification (Stage 5)
        logger.info("   ✅ Hard Validation passed. Moving to Stage 5.")
        state["cascade_stage"] = 5
        # НЕ возвращаем — код продолжит выполнение и попадёт в блок cascade_stage == 5
    
    # ==================== FIX P4: ПРОВЕРКА ДЕТЕЙ ДЛЯ ГРУПП (ВНЕ CASCADE 4) ====================
    # Эта проверка запускается для cascade_stage >= 4, потому что:
    # - При полных данных cascade_stage сразу = 5, минуя проверку внутри stage 4
    # - Для групп 4+ нужно ВСЕГДА уточнять наличие детей
    if cascade_stage >= 4:
        children_ages = params.get("children", [])
        children_mentioned = params.get("children_mentioned")
        no_children_phrases = params.get("no_children_explicit", False)
        adults = params.get("adults", 0)
        is_group = params.get("group_warning", False) or adults >= 4
        all_adults = params.get("all_adults", False)  # FIX CASE-009: проверка "X взрослых"
        
        # FIX CASE-009: Если all_adults=True ("X взрослых") → НЕ спрашиваем про детей
        if all_adults:
            logger.info(f"   🛡️ GUARD A (CASE-009): all_adults=True (cascade={cascade_stage}) → пропускаем вопрос про детей")
            # Не спрашиваем, идём дальше к quality check
        # Если группа 4+, дети не упомянуты явно — спрашиваем
        elif is_group and not no_children_phrases and children_mentioned is None and not children_ages:
            state["response"] = f"Вас {adults} человек. Едут ли с вами дети? Если да — укажите возраст каждого."
            state["last_question_type"] = "children_check"
            logger.info(f"   👨‍👩‍👧 FIX P4: Группа {adults} чел. (cascade={cascade_stage}) — спрашиваем про детей")
            return state
    
    # Этап 5: нужны детали (SOFT CLARIFICATION)
    # ЛОГИКА:
    # - Если отель известен → пропускаем (ищем)
    # - Если clarification_asked == False → спрашиваем про звёзды/питание
    # - Если clarification_asked == True → клиенту всё равно, ищем как есть
    if cascade_stage == 5:
        # Если отель уже известен — НЕ спрашиваем звёздность!
        if hotel_name:
            state["cascade_stage"] = 6
            # Не возвращаемся — продолжаем к поиску
        
        # Если уже спрашивали и клиент не ответил конкретно — значит всё равно
        elif state.get("clarification_asked", False):
            logger.info("   ✅ Soft Clarification: клиенту всё равно, ищем без фильтров")
            state["cascade_stage"] = 6
            state["skip_quality_check"] = True
            # Не возвращаемся — продолжаем к поиску
        
        # Первый раз спрашиваем про качество — БЕЗ "Принято:"
        else:
            state["response"] = "Какой уровень отеля и питание? (например: 5 звёзд, всё включено)"
            state["clarification_asked"] = True
            state["quality_check_asked"] = True
            state["last_question_type"] = "stars"
            return state
    
    # Этап 6 (cascade_stage == 6): всё собрано, но туров нет
    # Это значит поиск был выполнен, но вернул 0 результатов
    
    # Увеличиваем счётчик попыток
    state["search_attempts"] = state.get("search_attempts", 0) + 1
    
    # ==================== ЧЕСТНЫЙ ОТВЕТ: НЕТ ТУРОВ С ФИЛЬТРАМИ ====================
    # Если поиск вернул reason="no_tours_with_filters" или "no_tours_with_food_type" — предлагаем альтернативы
    search_reason = state.get("search_reason")
    
    # ==================== FIX 2.3: АЛЬТЕРНАТИВЫ ПО ТИПУ ПИТАНИЯ ====================
    if search_reason == "no_tours_with_food_type":
        food = params.get("food_type")
        food_name = {
            "AI": "Всё включено", "UAI": "Ультра Всё включено", "FB": "Полный пансион",
            "HB": "Полупансион", "BB": "Завтраки", "RO": "Без питания"
        }.get(food.value if hasattr(food, 'value') else str(food), str(food)) if food else "выбранное питание"
        
        country = params.get("destination_country", "выбранном направлении")
        stars = params.get("stars")
        stars_text = f"{stars}★" if stars else ""
        
        # Получаем доступные типы из suggestion
        available_foods_str = state.get("search_suggestion", "")
        if available_foods_str:
            food_names_map = {
                "AI": "Всё включено", "UAI": "Ультра Всё включено", "FB": "Полный пансион",
                "HB": "Полупансион", "BB": "Завтраки", "RO": "Без питания"
            }
            available_foods = [food_names_map.get(f, f) for f in available_foods_str.split(",")]
            available_text = ", ".join(available_foods)
            
            state["response"] = (
                f"К сожалению, отелей {stars_text} с питанием {food_name} {in_country(country)} на эти даты не найдено.\n\n"
                f"Доступно питание: {available_text}.\n\n"
                f"Посмотреть варианты с другим питанием?"
            )
            state["available_food_types"] = available_foods_str.split(",")
            state["awaiting_agreement"] = True
            state["pending_action"] = "alt_food_country"  # Новый action для страны
        else:
            state["response"] = (
                f"К сожалению, отелей {stars_text} с питанием {food_name} {in_country(country)} на эти даты не найдено.\n"
                f"Попробуйте изменить тип питания или даты."
            )
        return state
    
    if search_reason == "no_tours_with_filters":
        stars = params.get("stars")
        food = params.get("food_type")
        country = params.get("destination_country", "")
        
        # Формируем ЧЕСТНОЕ сообщение с предложением
        if stars:
            alt_stars = stars - 1 if stars > 3 else None
            if alt_stars:
                state["response"] = (
                    f"К сожалению, отелей {stars}★ на эти даты в {country} не найдено.\n\n"
                    f"Посмотреть варианты {alt_stars}★ или изменить даты?"
                )
                state["awaiting_agreement"] = True
                state["pending_action"] = "lower_stars"
                state["alt_stars"] = alt_stars
            else:
                state["response"] = (
                    f"К сожалению, туров на эти даты в {country} не найдено.\n"
                    f"Попробуйте изменить даты или город вылета."
                )
        else:
            state["response"] = (
                f"К сожалению, туров в {country} на указанные даты не найдено.\n"
                f"Попробуйте изменить даты или город вылета."
            )
        return state
    
    response_text, awaiting, action = generate_no_results_explanation(params, state)
    state["response"] = response_text
    state["awaiting_agreement"] = awaiting
    state["pending_action"] = action
    
    # Помечаем какой тип альтернативы предложили
    if action == "alt_departure":
        state["offered_alt_departure"] = True
    elif action == "alt_food":
        state["offered_alt_food"] = True
    elif action == "lower_stars":
        state["offered_lower_stars"] = True
    
    return state


