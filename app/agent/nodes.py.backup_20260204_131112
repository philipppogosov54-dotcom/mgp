    # Если есть контекст — добавляем
    country = params.get("destination_country")
    if country:
        question = f"{country} — отличный выбор для семейного отдыха! " + question
    
    state["response"] = question
    return state


def should_search(state: AgentState) -> str:
    """Определение следующего узла."""
    intent = state.get("intent", "search_tour")
    params = state.get("search_params", {})
    
    # ==================== ЭТАП 1: УТОЧНЕНИЕ ГОРОДА (DUAL_PURPOSE_CITIES) ====================
    if intent == "clarify_city":
        return "clarify_city"
    
    # ==================== КРИТИЧЕСКАЯ ПРОВЕРКА: ДЕТИ БЕЗ ВОЗРАСТА ====================
    if intent == "ask_child_ages":
        return "ask_child_ages"
    
    # ==================== ПАГИНАЦИЯ: ЕЩЁ ТУРЫ (GAP Analysis) ====================
    if intent == "more_tours":
        return "more_tours"
    
    # ==================== УГЛУБЛЁННЫЙ ПОИСК (GAP Analysis) ====================
    if intent == "continue_search":
        return "continue_search"
    
    # ==================== ГРУППОВАЯ ЗАЯВКА ====================
    if intent == "group_booking":
        return "booking"
    
    # ==================== НЕВАЛИДНАЯ СТРАНА ====================
    if intent == "invalid_country":
        return "invalid_country"
    
    if intent in ("booking", "phone_provided"):
        return "booking"
    
    if intent.startswith("faq_") or intent == "greeting":
        return "faq"
    
    if intent == "general_chat":
        return "general_chat"
    
    # ==================== ШАГ 1 FIX: ГОРЯЩИЕ ТУРЫ — ТОЛЬКО БАЗОВЫЕ ПАРАМЕТРЫ ====================
    # hottours.php API требует ТОЛЬКО: city (departure), country, items (лимит)
    # НЕ требует: adults, dates, stars, food_type!
    is_hot = params.get("is_hot_tour", False) or intent == "hot_tours"
    if is_hot:
        has_departure = params.get("departure_city")
        has_country = params.get("destination_country")
        
        # ШАГ 1 FIX: Для горящих нужны ТОЛЬКО departure + country!
        if has_departure and has_country:
            logger.info(f"🔥 ШАГ1: Горящие туры готовы — departure={has_departure}, country={has_country}")
            return "search"
        
        # Если параметры не собраны — переходим к каскаду
        logger.info(f"🔥 ШАГ1: Горящие туры — не все параметры (dep={has_departure}, country={has_country}) → каскад")
    
    # ==================== ШАГ 2 FIX: HOTEL ONLY — БЕЗ ГОРОДА ВЫЛЕТА ====================
    # Для режима hotel_only НЕ требуется departure_city!
    # Нужны только: country, dates, adults, nights
    search_mode = state.get("search_mode", "package")
    logger.info(f"🏨 DEBUG should_search: search_mode={search_mode}, params_keys={list(params.keys())}")
    if search_mode == "hotel_only":
        has_country = params.get("destination_country")
        has_dates = params.get("date_from") and params.get("dates_confirmed")
        has_adults = params.get("adults") and params.get("adults_explicit")
        has_nights = params.get("nights") or (params.get("date_from") and params.get("date_to"))
        
        # Логируем статус
        logger.info(f"🏨 ШАГ2: Hotel Only — country={has_country}, dates={has_dates}, adults={has_adults}, nights={has_nights}")
        
        # Для hotel_only не спрашиваем departure_city!
        if has_country and has_dates and has_adults and has_nights:
            # Проверяем качество (stars/food) для массовых направлений
            country = params.get("destination_country", "")
            is_mass = country in ("Турция", "Египет", "ОАЭ", "Таиланд", "Кипр", "Греция")
            has_quality = params.get("skip_quality_check") or (params.get("stars") and params.get("food_type"))
            
            if is_mass and not has_quality and not state.get("quality_check_asked"):
                logger.info(f"🏨 ШАГ2: Hotel Only — нужно качество для {country}")
                return "quality_check"
            
            logger.info(f"🏨 ШАГ2: Hotel Only готов к поиску!")
            return "search"
        
        # Если базовые параметры не собраны — каскад (но БЕЗ departure_city!)
        missing = []
        if not has_country:
            missing.append("country")
        if not has_dates:
            missing.append("dates")
        if not has_adults:
            missing.append("adults")
        if not has_nights:
            missing.append("nights")
        logger.info(f"🏨 ШАГ2: Hotel Only — не хватает: {missing} → каскад")
        # НЕ возвращаем "ask" здесь — падаем в стандартный каскад ниже
    
    # Если intent явно "search_tour" или "hot_tours" и cascade_stage == 6
    # Но ТОЛЬКО если питание уже указано или звёзды НЕ явные
    if intent in ("search_tour", "hot_tours") and state.get("cascade_stage") == 6:
        # P1 CRITICAL FIX: Если звёзды указаны ЯВНО, а питание НЕТ — нужно спросить питание!
        if params.get("stars_explicit") and not params.get("food_type") and not params.get("skip_quality_check"):
            if not state.get("quality_check_asked"):
                logger.info("   🍽️ P1 FIX (cascade=6): stars_explicit=True, food_type=None → спрашиваем питание")
                return "quality_check"
        return "search"
    
    # Каскад (пересчитываем только если не было явного указания)
    cascade_stage = state.get("cascade_stage") or get_cascade_stage(params, state.get("search_mode", "package"))
    
    # Если не все базовые параметры (включая город вылета!) — спрашиваем
    if cascade_stage <= 4:
        return "ask"
    
    # ==================== FIX P4 + ШАГ 2: ПРОВЕРКА ДЕТЕЙ ДЛЯ ГРУПП 4+ ====================
    # КРИТИЧНО: Эта проверка должна быть ПЕРЕД quality_check, чтобы:
    # 1. Не уйти в quality_check_handler -> END, минуя вопрос о детях
    # 2. Для групп 4+ уточнять наличие детей, НО ТОЛЬКО если НЕ сказано "X взрослых"
    # FIX ШАГ 2: "4 взрослых" = all_adults=True → НЕ спрашивать детей
    #            "4 человека" = all_adults=False → СПРАШИВАТЬ детей
    if cascade_stage >= 5:
        adults = params.get("adults", 0)
        children_ages = params.get("children", [])
        children_mentioned = params.get("children_mentioned")
        no_children_phrases = params.get("no_children_explicit", False)
        all_adults = params.get("all_adults", False)  # FIX ШАГ 2: Новый флаг
        is_group = params.get("group_warning", False) or adults >= 4
        
        # FIX ШАГ 2: Спрашиваем про детей ТОЛЬКО если:
        # - Группа 4+ человек
        # - НЕ сказано явно "взрослых" (all_adults=False)
        # - НЕ сказано "без детей" / "одни взрослые"
        # - Дети не упоминались
        if is_group and not all_adults and not no_children_phrases and children_mentioned is None and not children_ages:
            logger.info(f"   👨‍👩‍👧 FIX P4+ШАГ2: Группа {adults} чел., all_adults=False → спрашиваем про детей")
            # Возвращаем "ask" чтобы responder задал вопрос о детях
            return "ask"
    
    # Если нужны детали — quality_check (SOFT CLARIFICATION)
    # P1 FIX: Теперь проверяем питание даже для конкретного отеля!
    if cascade_stage == 5:
        # P1 FIX: Если отель известен — проверяем только питание (не звёзды)
        if params.get("hotel_name"):
            # Если питание указано или пользователь сказал "любое" — ищем
            if params.get("food_type") or params.get("food_type_explicit") or params.get("skip_quality_check"):
                return "search"
            # Если ещё не спрашивали питание — спрашиваем
            if not state.get("quality_check_asked"):
                return "quality_check"
            # Если спрашивали, но нет ответа — ищем с любым питанием
            return "search"
        
        # ==================== P1 CRITICAL FIX v2: ЗВЁЗДЫ ЯВНО → ПИТАНИЕ ОБЯЗАТЕЛЬНО ====================
        # Если звёзды указаны ЯВНО, а питание НЕТ — ОБЯЗАТЕЛЬНО спросить питание!
        # ВАЖНО: Игнорируем quality_check_asked! Пользователь мог ответить только на часть вопроса
        # (например, "4 звезды" в ответ на "Какой уровень отеля и питание?")
        if params.get("stars_explicit") and not params.get("food_type") and not params.get("skip_quality_check"):
            # НЕ проверяем quality_check_asked — спрашиваем про питание ВСЕГДА
            logger.info("   🍽️ P1 FIX v2: stars_explicit=True, food_type=None → спрашиваем питание (always)")
            return "quality_check"
        
        # Обычная логика для звёзд + питания (без отеля)
        if params.get("skip_quality_check"):
            return "search"
        
        # Если уже спрашивали — клиенту всё равно, ищем
        if state.get("clarification_asked"):
            return "search"
        
        # Если ещё не спрашивали — спрашиваем
        if not state.get("quality_check_asked"):
            return "quality_check"
    
    # ==================== P1 CRITICAL FIX v2: ПРОВЕРКА НА STAGE 6+ ====================
    # Если дошли до stage 6+ но звёзды явные, а питание не указано — вернуться и спросить
    # ВАЖНО: Игнорируем quality_check_asked — питание ОБЯЗАТЕЛЬНО при явных звёздах
    if params.get("stars_explicit") and not params.get("food_type") and not params.get("skip_quality_check"):
        logger.info("   🍽️ P1 FIX v2 (stage 6+): stars_explicit=True, food_type=None → спрашиваем питание")
        return "quality_check"
    
    # Иначе — поиск
    return "search"
